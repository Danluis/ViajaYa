<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>aspnet-ViajaYa-587d-4ee7-95cd-67fe64193954</UserSecretsId>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
        <DefaultItemExcludes>$(DefaultItemExcludes);ViajaYa.Tests/**;ViajaYa.Data/**;ViajaYa.Services/**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <None Update="Data\app.db" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Aplicada1.Core" Version="1.1.0" />
        <PackageReference Include="Blazor.Bootstrap" Version="3.1.0" />
        <PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid" Version="11.0.0" />
        <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="11.0.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0" PrivateAssets="all" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="11.0.0" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="ViajaYa.Tests/**/*.cs" />
        <Compile Remove="ViajaYa.Data/**/*.cs" />
        <Compile Remove="ViajaYa.Services/**/*.cs" />

        <Content Remove="ViajaYa.Tests/**" />
        <Content Remove="ViajaYa.Data/**" />
        <Content Remove="ViajaYa.Services/**" />

        <EmbeddedResource Remove="ViajaYa.Tests/**" />
        <EmbeddedResource Remove="ViajaYa.Data/**" />
        <EmbeddedResource Remove="ViajaYa.Services/**" />

        <None Remove="ViajaYa.Tests/**" />
        <None Remove="ViajaYa.Data/**" />
        <None Remove="ViajaYa.Services/**" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="ViajaYa.Data\ViajaYa.Data.csproj" />
        <ProjectReference Include="ViajaYa.Services\ViajaYa.Services.csproj" />
    </ItemGroup>

</Project>
