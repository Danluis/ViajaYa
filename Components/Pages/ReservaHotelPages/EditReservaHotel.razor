@page "/ReservaHoteles/Edit/{ReservaHotelId:int}"
@using ViajaYa.Models
@using ViajaYa.Services
@using ViajaYa.Extensors
@inject ReservaHotelService ReservaHotelService
@inject ClienteService ClienteService
@inject AgenteService AgenteService
@inject HotelService HotelService
@inject ToastService toastService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Modificar Reserva de Hotel - ViajaYa</PageTitle>

<div class="container-fluid py-4 px-3 px-lg-4">

    <div class="mb-4">
        <a href="/ReservaHoteles/Index" class="text-decoration-none text-secondary small">
            <i class="bi bi-arrow-left me-2"></i>Volver a reservas de hoteles
        </a>

        <div class="mt-3">
            <span class="badge bg-primary bg-opacity-10 text-primary mb-2">
                GESTION DE RESERVAS
            </span>
            <h2 class="fw-bold mb-1">Modificar reserva de hotel</h2>
            <p class="text-muted mb-0">
                Actualiza los datos de la reserva y administra los hoteles registrados.
            </p>
        </div>
    </div>

    @if (reserva is null)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
                <p class="text-muted mt-3 mb-0">Cargando reserva...</p>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm mb-4">

            <div class="card-header bg-white border-0 p-4">
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                    <div>
                        <h5 class="fw-bold mb-1">
                            <i class="bi bi-person-vcard text-primary me-2"></i>Informacion de la reserva
                        </h5>
                        <p class="text-muted small mb-0">
                            Reserva #@reserva.ReservaHotelId
                        </p>
                    </div>

                    <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2">
                        Editando reserva
                    </span>
                </div>
            </div>

            <div class="card-body p-4">
                <EditForm Model="reserva">
                    <div class="row g-3">

                        <div class="col-12 col-md-6 col-lg-4">
                            <label class="form-label fw-semibold">Cliente</label>
                            <InputSelect class="form-select" @bind-Value="reserva.ClienteId">
                                <option value="0">Seleccione un cliente</option>
                                @foreach (var c in clientes)
                                {
                                    <option value="@c.ClienteId">@c.Nombre</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-12 col-md-6 col-lg-4">
                            <label class="form-label fw-semibold">Agente</label>
                            <InputSelect class="form-select" @bind-Value="reserva.AgenteId">
                                <option value="0">Seleccione un agente</option>
                                @foreach (var a in agentes)
                                {
                                    <option value="@a.AgenteId">@a.Nombre</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-12 col-md-6 col-lg-4">
                            <label class="form-label fw-semibold">Fecha de reserva</label>
                            <InputDate class="form-control" @bind-Value="reserva.FechaReserva" />
                        </div>

                        <div class="col-12 col-md-6 col-lg-4">
                            <label class="form-label fw-semibold">Estado</label>
                            <InputSelect class="form-select" @bind-Value="reserva.Estado">
                                <option value="Confirmada">Confirmada</option>
                                <option value="Cancelada">Cancelada</option>
                            </InputSelect>
                        </div>

                    </div>
                </EditForm>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">

            <div class="card-header bg-white border-0 p-4">
                <h5 class="fw-bold mb-1">
                    <i class="bi bi-building text-primary me-2"></i>Detalle de hoteles
                </h5>
                <p class="text-muted small mb-0">
                    Agrega nuevos hoteles o modifica los detalles existentes.
                </p>
            </div>

            <div class="card-body p-4">

                <div class="row g-3 align-items-end mb-4">

                    <div class="col-12 col-lg-6">
                        <label class="form-label fw-semibold">Hotel</label>

                        <select class="form-select" @bind="hotelSeleccionadoId">
                            <option value="0">Seleccione un hotel</option>
                            @foreach (var h in hoteles)
                            {
                                <option value="@h.HotelId">
                                    @h.Nombre - @h.Destino?.Ciudad
                                    (@h.HabitacionesDisponibles disp. - @h.PrecioPorNoche.ToString("C")/noche)
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md-6 col-lg-2">
                        <label class="form-label fw-semibold">Habitaciones</label>
                        <input type="number"
                               min="1"
                               class="form-control"
                               @bind="cantidadHabSeleccionada" />
                    </div>

                    <div class="col-12 col-md-6 col-lg-2">
                        <label class="form-label fw-semibold">Noches</label>
                        <input type="number"
                               min="1"
                               class="form-control"
                               @bind="cantidadNochesSeleccionada" />
                    </div>

                    <div class="col-12 col-lg-2">
                        <button type="button"
                                class="btn btn-primary w-100"
                                @onclick="AgregarDetalle">
                            <i class="bi bi-plus-circle me-2"></i>Agregar
                        </button>
                    </div>

                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0">Hoteles registrados</h6>
                    <span class="badge bg-primary bg-opacity-10 text-primary">
                        @reserva.Detalles.Count hoteles
                    </span>
                </div>

                @if (!reserva.Detalles.Any())
                {
                    <div class="text-center py-5 border rounded-3">
                        <i class="bi bi-building text-muted display-4"></i>
                        <h6 class="fw-bold mt-3">No hay hoteles agregados</h6>
                        <p class="text-muted small mb-0">
                            Agrega al menos un hotel para guardar la reserva.
                        </p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Hotel</th>
                                    <th>Habitaciones</th>
                                    <th>Noches</th>
                                    <th>Precio/Noche</th>
                                    <th>Subtotal</th>
                                    <th class="text-center">Opciones</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var d in reserva.Detalles)
                                {
                                    <tr>
                                        <td class="fw-semibold">
                                            @hoteles.FirstOrDefault(h => h.HotelId == d.HotelId)?.Nombre
                                        </td>
                                        <td>@d.CantidadHabitaciones</td>
                                        <td>@d.CantidadNoches</td>
                                        <td class="text-nowrap">@d.PrecioUnitario.ToString("C")</td>
                                        <td class="fw-semibold text-success text-nowrap">
                                            @((d.CantidadHabitaciones * d.CantidadNoches * d.PrecioUnitario).ToString("C"))
                                        </td>
                                        <td class="text-center">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Quitar hotel"
                                                    @onclick="() => AbrirModalQuitar(d)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="d-flex justify-content-end mt-4">
                    <div class="bg-light rounded-3 p-3 text-end">
                        <span class="text-muted small d-block">Total de la reserva</span>
                        <h4 class="fw-bold text-success mb-0">
                            @reserva.Detalles.Sum(d => d.CantidadHabitaciones * d.CantidadNoches * d.PrecioUnitario).ToString("C")
                        </h4>
                    </div>
                </div>

            </div>
        </div>

        <div class="d-flex flex-column flex-sm-row justify-content-between gap-2 mb-4">

            <button type="button"
                    class="btn btn-outline-danger px-4"
                    @onclick="Eliminar">
                <i class="bi bi-trash me-2"></i>Eliminar reserva
            </button>

            <div class="d-flex flex-column flex-sm-row gap-2">
                <a href="/ReservaHoteles/Index" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-x-circle me-2"></i>Cancelar
                </a>

                <button type="button"
                        class="btn btn-primary px-4"
                        @onclick="Modificar">
                    <i class="bi bi-floppy me-2"></i>Guardar cambios
                </button>
            </div>

        </div>
    }

</div>

@if (mostrarModalQuitar)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">

                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-exclamation-circle text-warning me-2"></i>Confirmar accion
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalQuitar"></button>
                </div>

                <div class="modal-body">
                    <p class="mb-0">
                        Deseas quitar este hotel del detalle? Sus valores se cargaran en el formulario para que puedas ajustarlos.
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CerrarModalQuitar">
                        Cancelar
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmarQuitarDetalle">
                        <i class="bi bi-trash me-2"></i>Quitar hotel
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@if (mostrarModalEliminar)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">

                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-exclamation-triangle text-danger me-2"></i>Eliminar reserva
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalEliminar"></button>
                </div>

                <div class="modal-body">
                    <p>
                        Estas seguro de eliminar esta reserva? Las habitaciones se restauraran automaticamente.
                    </p>
                    <p class="text-danger small mb-0">
                        Esta accion no se puede deshacer.
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CerrarModalEliminar">
                        Cancelar
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmarEliminar">
                        <i class="bi bi-trash me-2"></i>Eliminar reserva
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int ReservaHotelId { get; set; }

    private ReservaHotel? reserva;
    private List<Cliente> clientes = new();
    private List<Agente> agentes = new();
    private List<Hotel> hoteles = new();

    private int hotelSeleccionadoId = 0;
    private int cantidadHabSeleccionada = 1;
    private int cantidadNochesSeleccionada = 1;

    private bool mostrarModalQuitar = false;
    private DetalleReservaHotel? detalleAQuitar;

    private bool mostrarModalEliminar = false;

    protected override async Task OnInitializedAsync()
    {
        var resultadoClientes = await ClienteService.GetList(c => true);
        clientes = resultadoClientes.IsSuccess ? resultadoClientes.Value! : new List<Cliente>();

        var resultadoAgentes = await AgenteService.GetList(a => true);
        agentes = resultadoAgentes.IsSuccess ? resultadoAgentes.Value! : new List<Agente>();

        var resultadoHoteles = await HotelService.GetList(h => true);
        hoteles = resultadoHoteles.IsSuccess ? resultadoHoteles.Value! : new List<Hotel>();

        var resultado = await ReservaHotelService.Buscar(ReservaHotelId);
        if (resultado.IsSuccess && resultado.Value is not null)
        {
            reserva = resultado.Value;
        }
        else
        {
            toastService.ShowError("Reserva no encontrada");
            NavigationManager.NavigateTo("/ReservaHoteles/Index");
        }
    }

    private void AgregarDetalle()
    {
        if (reserva is null) return;

        if (reserva.ClienteId == 0)
        {
            toastService.ShowWarning("Debe seleccionar un cliente antes de agregar un hotel");
            return;
        }

        if (reserva.AgenteId == 0)
        {
            toastService.ShowWarning("Debe seleccionar un agente antes de agregar un hotel");
            return;
        }

        if (hotelSeleccionadoId == 0)
        {
            toastService.ShowWarning("Debe seleccionar un hotel");
            return;
        }

        if (cantidadHabSeleccionada <= 0 || cantidadNochesSeleccionada <= 0)
        {
            toastService.ShowWarning("La cantidad de habitaciones y noches debe ser mayor a 0");
            return;
        }

        var hotel = hoteles.FirstOrDefault(h => h.HotelId == hotelSeleccionadoId);
        if (hotel is null)
        {
            toastService.ShowWarning("El hotel seleccionado ya no existe");
            return;
        }

        reserva.Detalles.Add(new DetalleReservaHotel
        {
            HotelId = hotelSeleccionadoId,
            CantidadHabitaciones = cantidadHabSeleccionada,
            CantidadNoches = cantidadNochesSeleccionada,
            PrecioUnitario = hotel.PrecioPorNoche
        });

        hotelSeleccionadoId = 0;
        cantidadHabSeleccionada = 1;
        cantidadNochesSeleccionada = 1;
    }

    private void AbrirModalQuitar(DetalleReservaHotel detalle)
    {
        detalleAQuitar = detalle;
        mostrarModalQuitar = true;
    }

    private void CerrarModalQuitar()
    {
        mostrarModalQuitar = false;
        detalleAQuitar = null;
    }

    private void ConfirmarQuitarDetalle()
    {
        if (reserva is null || detalleAQuitar is null) return;

        hotelSeleccionadoId = detalleAQuitar.HotelId;
        cantidadHabSeleccionada = detalleAQuitar.CantidadHabitaciones;
        cantidadNochesSeleccionada = detalleAQuitar.CantidadNoches;

        reserva.Detalles.Remove(detalleAQuitar);

        mostrarModalQuitar = false;
        detalleAQuitar = null;
    }

    private async Task Modificar()
    {
        if (reserva is null) return;

        if (!reserva.Detalles.Any())
        {
            toastService.ShowWarning("Debe tener al menos un hotel en el detalle");
            return;
        }

        var resultado = await ReservaHotelService.Guardar(reserva);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("Reserva modificada correctamente");
            NavigationManager.NavigateTo("/ReservaHoteles/Index");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError(resultado.Error.Description);
        });
    }

    private void Eliminar()
    {
        mostrarModalEliminar = true;
    }

    private void CerrarModalEliminar()
    {
        mostrarModalEliminar = false;
    }

    private async Task ConfirmarEliminar()
    {
        mostrarModalEliminar = false;
        if (reserva is null) return;

        var resultado = await ReservaHotelService.Eliminar(reserva.ReservaHotelId);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("Reserva eliminada correctamente");
            NavigationManager.NavigateTo("/ReservaHoteles/Index");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError(resultado.Error.Description);
        });
    }
}
