@page "/ReservaHoteles/Index"
@using ViajaYa.Models
@using ViajaYa.Services
@using Microsoft.AspNetCore.Components.QuickGrid
@inject ReservaHotelService ReservaHotelService
@rendermode InteractiveServer

<PageTitle>Reservas de hotel - ViajaYa</PageTitle>

<div class="container-fluid py-4 px-3 px-lg-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <a href="/" class="text-decoration-none text-secondary small">
                <i class="bi bi-arrow-left me-2"></i>Volver al inicio
            </a>

            <div class="mt-3">
                <span class="badge bg-primary bg-opacity-10 text-primary mb-2">
                    GESTION DEL SISTEMA
                </span>

                <h2 class="fw-bold mb-1">Reservas de hoteles</h2>
                <p class="text-muted mb-0">
                    Consulta, busca y administra las reservas de hoteles registradas.
                </p>
            </div>
        </div>

        <a href="/ReservaHoteles/Create" class="btn btn-primary px-4 py-2">
            <i class="bi bi-plus-circle me-2"></i>Nueva reserva
        </a>

    </div>

    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-1">Total de reservas</p>
                            <h3 class="fw-bold mb-0">
                                @(reservas?.Count ?? 0)
                            </h3>
                        </div>

                        <div class="rounded-3 bg-primary bg-opacity-10 p-3">
                            <i class="bi bi-building-check text-primary fs-3"></i>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white border-0 p-4">
            <h5 class="fw-bold mb-1">
                <i class="bi bi-funnel text-primary me-2"></i>Busqueda y filtros
            </h5>
            <p class="text-muted small mb-0">
                Utiliza los filtros para encontrar una reserva.
            </p>
        </div>

        <div class="card-body px-4 pb-4">

            <div class="row g-3">

                <div class="col-12 col-md-4">
                    <label class="form-label fw-semibold">Filtrar por</label>

                    <select class="form-select" @bind="criterioSeleccionado">
                        <option value="">Elija una opcion</option>
                        <option value="reservaId">ID de reserva</option>
                        <option value="cliente">Cliente</option>
                        <option value="agente">Agente</option>
                        <option value="estado">Estado</option>
                    </select>
                </div>

                <div class="col-12 col-md-8">
                    <label class="form-label fw-semibold">Buscar reserva</label>

                    <div class="input-group">
                        <span class="input-group-text bg-light">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               class="form-control"
                               placeholder="Escribe el dato que deseas buscar..."
                               @bind="textoBusqueda"
                               @bind:event="oninput"
                               @onkeyup="ManejarTecla" />

                        <button type="button"
                                class="btn btn-primary"
                                @onclick="Buscar">
                            Buscar
                        </button>
                    </div>
                </div>

                <div class="col-12 col-md-5">
                    <label class="form-label fw-semibold">Fecha desde</label>

                    <div class="input-group">
                        <span class="input-group-text bg-light">
                            <i class="bi bi-calendar-event"></i>
                        </span>

                        <input type="date"
                               class="form-control"
                               @bind="fechaDesde" />
                    </div>
                </div>

                <div class="col-12 col-md-5">
                    <label class="form-label fw-semibold">Fecha hasta</label>

                    <div class="input-group">
                        <span class="input-group-text bg-light">
                            <i class="bi bi-calendar-check"></i>
                        </span>

                        <input type="date"
                               class="form-control"
                               @bind="fechaHasta" />
                    </div>
                </div>

                <div class="col-12 col-md-2 d-flex align-items-end">
                    <div class="d-flex gap-2 w-100">

                        <button type="button"
                                class="btn btn-outline-primary flex-grow-1"
                                title="Aplicar filtros"
                                @onclick="Buscar">
                            <i class="bi bi-filter"></i>
                        </button>

                        <button type="button"
                                class="btn btn-outline-secondary flex-grow-1"
                                title="Limpiar filtros"
                                @onclick="Limpiar">
                            <i class="bi bi-eraser"></i>
                        </button>

                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 p-4">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                <div>
                    <h5 class="fw-bold mb-1">Listado de reservas</h5>
                    <p class="text-muted small mb-0">
                        Consulta la informacion de las reservas registradas.
                    </p>
                </div>

                <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2">
                    @(reservas?.Count ?? 0) registros
                </span>
            </div>
        </div>

        <div class="card-body p-0">

            @if (reservas is null)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="text-muted mt-3 mb-0">Cargando reservas...</p>
                </div>
            }
            else if (reservas.Count == 0)
            {
                <div class="text-center py-5 px-3">
                    <i class="bi bi-journal-x text-muted display-4"></i>
                    <h5 class="fw-bold mt-3">No hay reservas disponibles</h5>
                    <p class="text-muted mb-3">
                        No se encontraron reservas con los criterios seleccionados.
                    </p>
                    <button class="btn btn-outline-primary" @onclick="Limpiar">
                        <i class="bi bi-arrow-counterclockwise me-2"></i>Limpiar filtros
                    </button>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <QuickGrid Items="@reservas.AsQueryable()"
                               Pagination="@paginacion"
                               Class="table table-hover align-middle mb-0">

                        <PropertyColumn Property="@(r => r.ReservaHotelId)"
                                        Title="ID"
                                        Sortable="true" />

                        <TemplateColumn Title="Cliente">
                            <span class="fw-semibold">
                                @context.Cliente?.Nombre
                            </span>
                        </TemplateColumn>

                        <TemplateColumn Title="Agente">
                            @context.Agente?.Nombre
                        </TemplateColumn>

                        <TemplateColumn Title="Fecha">
                            <span class="text-nowrap">
                                <i class="bi bi-calendar-event text-primary me-1"></i>
                                @context.FechaReserva.ToString("dd/MM/yyyy")
                            </span>
                        </TemplateColumn>

                        <PropertyColumn Property="@(r => r.Estado)"
                                        Title="Estado"
                                        Sortable="true" />

                        <TemplateColumn Title="Total">
                            <span class="fw-semibold text-success text-nowrap">
                                @context.Detalles.Sum(d => d.CantidadHabitaciones * d.CantidadNoches * d.PrecioUnitario).ToString("C")
                            </span>
                        </TemplateColumn>

                        <TemplateColumn Title="Opciones">
                            <a href="@($"/ReservaHoteles/Edit/{context.ReservaHotelId}")"
                               class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil-square me-1"></i>Editar
                            </a>
                        </TemplateColumn>

                    </QuickGrid>
                </div>

                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3 p-3 border-top">

                    <span class="text-muted small">
                        Cantidad de reservas: @reservas.Count
                    </span>

                    <Paginator State="@paginacion" />

                </div>
            }

        </div>
    </div>

</div>

@code {
    private List<ReservaHotel>? reservas;
    private string criterioSeleccionado = "";
    private string textoBusqueda = "";
    private DateTime? fechaDesde;
    private DateTime? fechaHasta;
    private PaginationState paginacion = new PaginationState { ItemsPerPage = 5 };

    private async Task<List<ReservaHotel>> ObtenerLista(System.Linq.Expressions.Expression<Func<ReservaHotel, bool>> criterio)
    {
        var resultado = await ReservaHotelService.GetList(criterio);
        return resultado.IsSuccess ? resultado.Value! : new List<ReservaHotel>();
    }

    protected override async Task OnInitializedAsync()
    {
        reservas = await ObtenerLista(r => true);
    }

    private async Task ManejarTecla(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Buscar();
        }
    }

    private async Task Buscar()
    {
        var lista = await ObtenerLista(r => true);

        if (!string.IsNullOrWhiteSpace(textoBusqueda) && !string.IsNullOrEmpty(criterioSeleccionado))
        {
            switch (criterioSeleccionado)
            {
                case "reservaId":
                    if (int.TryParse(textoBusqueda, out int idBuscado))
                        lista = lista.Where(r => r.ReservaHotelId == idBuscado).ToList();
                    else
                        lista = new List<ReservaHotel>();
                    break;

                case "cliente":
                    lista = lista.Where(r => r.Cliente != null && r.Cliente.Nombre.ToLower().Contains(textoBusqueda.ToLower())).ToList();
                    break;

                case "agente":
                    lista = lista.Where(r => r.Agente != null && r.Agente.Nombre.ToLower().Contains(textoBusqueda.ToLower())).ToList();
                    break;

                case "estado":
                    lista = lista.Where(r => r.Estado.ToLower().Contains(textoBusqueda.ToLower())).ToList();
                    break;
            }
        }

        if (fechaDesde.HasValue)
        {
            lista = lista.Where(r => r.FechaReserva.Date >= fechaDesde.Value.Date).ToList();
        }

        if (fechaHasta.HasValue)
        {
            lista = lista.Where(r => r.FechaReserva.Date <= fechaHasta.Value.Date).ToList();
        }

        reservas = lista;
    }

    private async Task Limpiar()
    {
        criterioSeleccionado = "";
        textoBusqueda = "";
        fechaDesde = null;
        fechaHasta = null;

        reservas = await ObtenerLista(r => true);
    }
}
