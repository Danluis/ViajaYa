@page "/ReservaVuelos/Edit/{ReservaVueloId:int}"
@using ViajaYa.Models
@using ViajaYa.Services
@using ViajaYa.Extensors
@inject ReservaVueloService ReservaVueloService
@inject ClienteService ClienteService
@inject AgenteService AgenteService
@inject VueloService VueloService
@inject ToastService toastService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Modificar reserva de vuelo - ViajaYa</PageTitle>

<div class="reserva-vuelo-edit">

    <div class="reserva-vuelo-edit-heading">
        <a href="/ReservaVuelos/Index" class="reserva-vuelo-edit-back">
            <i class="bi bi-arrow-left me-2"></i>Volver a reservas
        </a>

        <div class="mt-3">
            <span class="reserva-vuelo-edit-tag">GESTION DE RESERVAS</span>
            <h2>Modificar reserva de vuelo</h2>
            <p>Actualiza los datos de la reserva y administra sus vuelos.</p>
        </div>
    </div>

    @if (reserva is null)
    {
        <div class="reserva-vuelo-edit-loading">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p>Cargando reserva...</p>
        </div>
    }
    else
    {
        <section class="reserva-vuelo-edit-card">

            <div class="reserva-vuelo-edit-card-header">
                <div class="reserva-vuelo-edit-header-main">
                    <div class="reserva-vuelo-edit-icon">
                        <i class="bi bi-journal-text"></i>
                    </div>
                    <div>
                        <h5>Informacion de la reserva</h5>
                        <p>Modifica los datos generales de la reserva.</p>
                    </div>
                </div>

                <span class="reserva-vuelo-edit-id">
                    Reserva #@reserva.ReservaVueloId
                </span>
            </div>

            <div class="reserva-vuelo-edit-body">
                <EditForm Model="reserva">
                    <div class="row g-3">

                        <div class="col-12 col-md-4">
                            <label class="reserva-vuelo-edit-label">Cliente</label>
                            <InputSelect class="form-select reserva-vuelo-edit-input" @bind-Value="reserva.ClienteId">
                                <option value="0">Seleccione un cliente</option>
                                @foreach (var c in clientes)
                                {
                                    <option value="@c.ClienteId">@c.Nombre</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="reserva-vuelo-edit-label">Agente</label>
                            <InputSelect class="form-select reserva-vuelo-edit-input" @bind-Value="reserva.AgenteId">
                                <option value="0">Seleccione un agente</option>
                                @foreach (var a in agentes)
                                {
                                    <option value="@a.AgenteId">@a.Nombre</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="reserva-vuelo-edit-label">Fecha de reserva</label>
                            <InputDate class="form-control reserva-vuelo-edit-input" @bind-Value="reserva.FechaReserva" />
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="reserva-vuelo-edit-label">Estado</label>
                            <InputSelect class="form-select reserva-vuelo-edit-input" @bind-Value="reserva.Estado">
                                <option value="Confirmada">Confirmada</option>
                                <option value="Cancelada">Cancelada</option>
                            </InputSelect>
                        </div>

                    </div>
                </EditForm>
            </div>
        </section>

        <section class="reserva-vuelo-edit-card">

            <div class="reserva-vuelo-edit-card-header">
                <div class="reserva-vuelo-edit-header-main">
                    <div class="reserva-vuelo-edit-icon">
                        <i class="bi bi-airplane"></i>
                    </div>
                    <div>
                        <h5>Agregar vuelos</h5>
                        <p>Selecciona un vuelo y la cantidad de asientos.</p>
                    </div>
                </div>
            </div>

            <div class="reserva-vuelo-edit-body">
                <div class="row g-3 align-items-end">

                    <div class="col-12 col-lg-6">
                        <label class="reserva-vuelo-edit-label">Vuelo</label>
                        <select class="form-select reserva-vuelo-edit-input" @bind="vueloSeleccionadoId">
                            <option value="0">Seleccione un vuelo</option>
                            @foreach (var v in vuelos)
                            {
                                <option value="@v.VueloId">
                                    @v.NumeroVuelo - @v.Destino?.Ciudad
                                    (@v.AsientosDisponibles disp. - @v.Precio.ToString("C"))
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md-5 col-lg-3">
                        <label class="reserva-vuelo-edit-label">Cantidad de asientos</label>
                        <input type="number"
                               min="1"
                               class="form-control reserva-vuelo-edit-input"
                               @bind="cantidadSeleccionada" />
                    </div>

                    <div class="col-12 col-md-7 col-lg-3">
                        <button type="button"
                                class="btn reserva-vuelo-edit-btn-add w-100"
                                @onclick="AgregarDetalle">
                            <i class="bi bi-plus-circle me-2"></i>Agregar vuelo
                        </button>
                    </div>

                </div>
            </div>
        </section>

        <section class="reserva-vuelo-edit-card">

            <div class="reserva-vuelo-edit-card-header reserva-vuelo-edit-list-header">
                <div>
                    <h5>Detalle de vuelos</h5>
                    <p>Revisa los vuelos incluidos en esta reserva.</p>
                </div>

                <span class="reserva-vuelo-edit-count">
                    @reserva.Detalles.Count vuelos
                </span>
            </div>

            <div class="reserva-vuelo-edit-body reserva-vuelo-edit-table-body">

                @if (!reserva.Detalles.Any())
                {
                    <div class="reserva-vuelo-edit-empty">
                        <div class="reserva-vuelo-edit-empty-icon">
                            <i class="bi bi-airplane"></i>
                        </div>
                        <h6>No hay vuelos agregados</h6>
                        <p>Agrega al menos un vuelo para modificar la reserva.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle reserva-vuelo-edit-table">
                            <thead>
                                <tr>
                                    <th>Vuelo</th>
                                    <th>Cantidad</th>
                                    <th>Precio unitario</th>
                                    <th>Subtotal</th>
                                    <th class="text-center">Opciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in reserva.Detalles)
                                {
                                    <tr>
                                        <td class="fw-semibold">
                                            @vuelos.FirstOrDefault(v => v.VueloId == d.VueloId)?.NumeroVuelo
                                        </td>
                                        <td>@d.CantidadAsientos</td>
                                        <td class="text-nowrap">@d.PrecioUnitario.ToString("C")</td>
                                        <td class="fw-semibold text-success text-nowrap">
                                            @((d.CantidadAsientos * d.PrecioUnitario).ToString("C"))
                                        </td>
                                        <td class="text-center">
                                            <button type="button"
                                                    class="btn btn-sm reserva-vuelo-edit-btn-remove"
                                                    @onclick="() => AbrirModalQuitar(d)"
                                                    title="Quitar vuelo">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </div>

            <div class="reserva-vuelo-edit-footer">
                <div class="reserva-vuelo-edit-total">
                    <span>Total de la reserva</span>
                    <h3>
                        @reserva.Detalles.Sum(d => d.CantidadAsientos * d.PrecioUnitario).ToString("C")
                    </h3>
                </div>

                <div class="reserva-vuelo-edit-footer-actions">
                    <a href="/ReservaVuelos/Index" class="btn reserva-vuelo-edit-btn-cancel">
                        <i class="bi bi-x-circle me-2"></i>Cancelar
                    </a>

                    <button type="button"
                            class="btn reserva-vuelo-edit-btn-save"
                            @onclick="Modificar">
                        <i class="bi bi-floppy me-2"></i>Guardar cambios
                    </button>
                </div>
            </div>

            <div class="reserva-vuelo-edit-delete-area">
                <button type="button"
                        class="btn reserva-vuelo-edit-btn-delete-reserva"
                        @onclick="Eliminar">
                    <i class="bi bi-trash me-2"></i>Eliminar reserva completa
                </button>
            </div>

        </section>
    }

</div>

@if (mostrarModalQuitar)
{
    <div class="reserva-vuelo-edit-modal-backdrop">
        <div class="modal-dialog modal-dialog-centered reserva-vuelo-edit-modal-dialog">
            <div class="modal-content reserva-vuelo-edit-modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-circle text-warning me-2"></i>
                        Confirmar eliminacion
                    </h5>
                    <button type="button"
                            class="btn-close"
                            aria-label="Cerrar"
                            @onclick="CerrarModalQuitar">
                    </button>
                </div>

                <div class="modal-body">
                    <p class="mb-0">
                        Desea quitar este vuelo del detalle? Sus valores se cargaran
                        en el formulario para que pueda ajustarlos.
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn reserva-vuelo-edit-btn-cancel"
                            @onclick="CerrarModalQuitar">
                        Cancelar
                    </button>

                    <button type="button"
                            class="btn reserva-vuelo-edit-btn-delete-confirm"
                            @onclick="ConfirmarQuitarDetalle">
                        <i class="bi bi-trash me-2"></i>Quitar vuelo
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@if (mostrarModalEliminar)
{
    <div class="reserva-vuelo-edit-modal-backdrop">
        <div class="modal-dialog modal-dialog-centered reserva-vuelo-edit-modal-dialog">
            <div class="modal-content reserva-vuelo-edit-modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle text-danger me-2"></i>
                        Confirmar eliminacion
                    </h5>
                    <button type="button"
                            class="btn-close"
                            aria-label="Cerrar"
                            @onclick="CerrarModalEliminar">
                    </button>
                </div>

                <div class="modal-body">
                    <p class="mb-0">
                        Esta seguro de eliminar esta reserva? Los asientos se restauraran
                        automaticamente. Esta accion no se puede deshacer.
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn reserva-vuelo-edit-btn-cancel"
                            @onclick="CerrarModalEliminar">
                        Cancelar
                    </button>

                    <button type="button"
                            class="btn reserva-vuelo-edit-btn-delete-confirm"
                            @onclick="ConfirmarEliminar">
                        <i class="bi bi-trash me-2"></i>Eliminar reserva
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int ReservaVueloId { get; set; }

    private ReservaVuelo? reserva;
    private List<Cliente> clientes = new();
    private List<Agente> agentes = new();
    private List<Vuelo> vuelos = new();

    private int vueloSeleccionadoId = 0;
    private int cantidadSeleccionada = 1;

    private bool mostrarModalQuitar = false;
    private DetalleReservaVuelo? detalleAQuitar;

    private bool mostrarModalEliminar = false;

    protected override async Task OnInitializedAsync()
    {
        var resultadoClientes = await ClienteService.GetList(c => true);
        clientes = resultadoClientes.IsSuccess ? resultadoClientes.Value! : new List<Cliente>();

        var resultadoAgentes = await AgenteService.GetList(a => true);
        agentes = resultadoAgentes.IsSuccess ? resultadoAgentes.Value! : new List<Agente>();

        var resultadoVuelos = await VueloService.GetList(v => true);
        vuelos = resultadoVuelos.IsSuccess ? resultadoVuelos.Value! : new List<Vuelo>();

        var resultado = await ReservaVueloService.Buscar(ReservaVueloId);

        if (resultado.IsSuccess && resultado.Value is not null)
        {
            reserva = resultado.Value;
        }
        else
        {
            toastService.ShowError("Reserva no encontrada");
            NavigationManager.NavigateTo("/ReservaVuelos/Index");
        }
    }

    private void AgregarDetalle()
    {
        if (reserva is null) return;

        if (reserva.ClienteId == 0)
        {
            toastService.ShowWarning("Debe seleccionar un cliente antes de agregar un vuelo");
            return;
        }

        if (reserva.AgenteId == 0)
        {
            toastService.ShowWarning("Debe seleccionar un agente antes de agregar un vuelo");
            return;
        }

        if (vueloSeleccionadoId == 0)
        {
            toastService.ShowWarning("Debe seleccionar un vuelo");
            return;
        }

        if (cantidadSeleccionada <= 0)
        {
            toastService.ShowWarning("La cantidad debe ser mayor a 0");
            return;
        }

        var vuelo = vuelos.FirstOrDefault(v => v.VueloId == vueloSeleccionadoId);

        if (vuelo is null)
        {
            toastService.ShowWarning("El vuelo seleccionado ya no existe");
            return;
        }

        reserva.Detalles.Add(new DetalleReservaVuelo
        {
            VueloId = vueloSeleccionadoId,
            CantidadAsientos = cantidadSeleccionada,
            PrecioUnitario = vuelo.Precio
        });

        vueloSeleccionadoId = 0;
        cantidadSeleccionada = 1;
    }

    private void AbrirModalQuitar(DetalleReservaVuelo detalle)
    {
        detalleAQuitar = detalle;
        mostrarModalQuitar = true;
    }

    private void CerrarModalQuitar()
    {
        mostrarModalQuitar = false;
        detalleAQuitar = null;
    }

    private void ConfirmarQuitarDetalle()
    {
        if (reserva is null || detalleAQuitar is null) return;

        vueloSeleccionadoId = detalleAQuitar.VueloId;
        cantidadSeleccionada = detalleAQuitar.CantidadAsientos;

        reserva.Detalles.Remove(detalleAQuitar);

        mostrarModalQuitar = false;
        detalleAQuitar = null;
    }

    private async Task Modificar()
    {
        if (reserva is null) return;

        if (!reserva.Detalles.Any())
        {
            toastService.ShowWarning("Debe tener al menos un vuelo en el detalle");
            return;
        }

        var resultado = await ReservaVueloService.Guardar(reserva);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("Reserva modificada correctamente");
            NavigationManager.NavigateTo("/ReservaVuelos/Index");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError(resultado.Error.Description);
        });
    }

    private void Eliminar()
    {
        mostrarModalEliminar = true;
    }

    private void CerrarModalEliminar()
    {
        mostrarModalEliminar = false;
    }

    private async Task ConfirmarEliminar()
    {
        mostrarModalEliminar = false;

        if (reserva is null) return;

        var resultado = await ReservaVueloService.Eliminar(reserva.ReservaVueloId);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("Reserva eliminada correctamente");
            NavigationManager.NavigateTo("/ReservaVuelos/Index");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError(resultado.Error.Description);
        });
    }
}