@page "/ReservaVuelos/Create"
@using ViajaYa.Models
@using ViajaYa.Services
@using ViajaYa.Extensors
@inject ReservaVueloService ReservaVueloService
@inject ClienteService ClienteService
@inject AgenteService AgenteService
@inject VueloService VueloService
@inject ToastService toastService
@inject NavigationManager NavigationManager

<PageTitle>Crear reserva de vuelo - ViajaYa</PageTitle>

<div class="container-fluid py-4 px-3 px-lg-4">

    <div class="mb-4">
        <a href="/ReservaVuelos/Index" class="text-decoration-none text-secondary small">
            <i class="bi bi-arrow-left me-2"></i>Volver a reservas
        </a>

        <div class="mt-3">
            <span class="badge bg-primary bg-opacity-10 text-primary mb-2">
                GESTION DE RESERVAS
            </span>
            <h2 class="fw-bold mb-1">Nueva reserva de vuelo</h2>
            <p class="text-muted mb-0">
                Registra los datos del cliente y agrega los vuelos que formaran parte de la reserva.
            </p>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white border-0 p-4">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 bg-primary bg-opacity-10 p-3">
                    <i class="bi bi-journal-plus text-primary fs-3"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-1">Datos de la reserva</h5>
                    <p class="text-muted small mb-0">
                        Selecciona el cliente, agente y fecha de reserva.
                    </p>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <EditForm Model="reserva">
                <div class="row g-3">

                    <div class="col-12 col-md-4">
                        <label class="form-label fw-semibold">Cliente</label>
                        <InputSelect class="form-select" @bind-Value="reserva.ClienteId">
                            <option value="0">Seleccione un cliente</option>
                            @foreach (var c in clientes)
                            {
                                <option value="@c.ClienteId">@c.Nombre</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label fw-semibold">Agente</label>
                        <InputSelect class="form-select" @bind-Value="reserva.AgenteId">
                            <option value="0">Seleccione un agente</option>
                            @foreach (var a in agentes)
                            {
                                <option value="@a.AgenteId">@a.Nombre</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label fw-semibold">Fecha de reserva</label>
                        <InputDate class="form-control" @bind-Value="reserva.FechaReserva" />
                    </div>

                </div>
            </EditForm>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white border-0 p-4">
            <h5 class="fw-bold mb-1">
                <i class="bi bi-airplane text-primary me-2"></i>Detalle de vuelos
            </h5>
            <p class="text-muted small mb-0">
                Selecciona un vuelo y la cantidad de asientos que deseas agregar.
            </p>
        </div>

        <div class="card-body p-4">
            <div class="row g-3 align-items-end">

                <div class="col-12 col-lg-6">
                    <label class="form-label fw-semibold">Vuelo</label>
                    <select class="form-select" @bind="vueloSeleccionadoId">
                        <option value="0">Seleccione un vuelo</option>
                        @foreach (var v in vuelos)
                        {
                            <option value="@v.VueloId">
                                @v.NumeroVuelo - @v.Destino?.Ciudad
                                (@v.AsientosDisponibles disp. - @v.Precio.ToString("C"))
                            </option>
                        }
                    </select>
                </div>

                <div class="col-12 col-md-5 col-lg-3">
                    <label class="form-label fw-semibold">Cantidad de asientos</label>
                    <input type="number"
                           min="1"
                           class="form-control"
                           @bind="cantidadSeleccionada" />
                </div>

                <div class="col-12 col-md-7 col-lg-3">
                    <button type="button"
                            class="btn btn-primary w-100"
                            @onclick="AgregarDetalle">
                        <i class="bi bi-plus-circle me-2"></i>Agregar vuelo
                    </button>
                </div>

            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 p-4">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                <div>
                    <h5 class="fw-bold mb-1">Vuelos agregados</h5>
                    <p class="text-muted small mb-0">
                        Revisa los vuelos y las cantidades antes de guardar.
                    </p>
                </div>

                <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2">
                    @reserva.Detalles.Count vuelos
                </span>
            </div>
        </div>

        <div class="card-body p-0">

            @if (!reserva.Detalles.Any())
            {
                <div class="text-center py-5 px-3">
                    <i class="bi bi-airplane text-muted display-4"></i>
                    <h5 class="fw-bold mt-3">No hay vuelos agregados</h5>
                    <p class="text-muted mb-0">
                        Selecciona un vuelo para comenzar a crear el detalle de la reserva.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Vuelo</th>
                                <th>Cantidad</th>
                                <th>Precio unitario</th>
                                <th>Subtotal</th>
                                <th class="text-center">Opciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in reserva.Detalles)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @vuelos.FirstOrDefault(v => v.VueloId == d.VueloId)?.NumeroVuelo
                                    </td>
                                    <td>@d.CantidadAsientos</td>
                                    <td class="text-nowrap">@d.PrecioUnitario.ToString("C")</td>
                                    <td class="fw-semibold text-success text-nowrap">
                                        @((d.CantidadAsientos * d.PrecioUnitario).ToString("C"))
                                    </td>
                                    <td class="text-center">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                @onclick="() => AbrirModalQuitar(d)"
                                                title="Quitar vuelo">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>

        <div class="card-footer bg-white p-4">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">

                <div>
                    <span class="text-muted small">Total de la reserva</span>
                    <h3 class="fw-bold text-success mb-0">
                        @reserva.Detalles.Sum(d => d.CantidadAsientos * d.PrecioUnitario).ToString("C")
                    </h3>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-2">
                    <a href="/ReservaVuelos/Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-x-circle me-2"></i>Cancelar
                    </a>

                    <button type="button"
                            class="btn btn-primary px-4"
                            @onclick="Guardar">
                        <i class="bi bi-floppy me-2"></i>Guardar reserva
                    </button>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="modal fade @(mostrarModalQuitar ? "show d-block" : "")"
     tabindex="-1"
     style="@(mostrarModalQuitar ? "background-color: rgba(0,0,0,0.5);" : "")">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">

            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-exclamation-circle text-warning me-2"></i>
                    Confirmar eliminacion
                </h5>
                <button type="button"
                        class="btn-close"
                        @onclick="CerrarModalQuitar">
                </button>
            </div>

            <div class="modal-body">
                <p class="mb-0">
                    Desea quitar este vuelo del detalle? Sus valores se cargaran
                    en el formulario para que pueda ajustarlos.
                </p>
            </div>

            <div class="modal-footer border-0">
                <button type="button"
                        class="btn btn-outline-secondary"
                        @onclick="CerrarModalQuitar">
                    Cancelar
                </button>

                <button type="button"
                        class="btn btn-danger"
                        @onclick="ConfirmarQuitarDetalle">
                    <i class="bi bi-trash me-2"></i>Quitar vuelo
                </button>
            </div>

        </div>
    </div>
</div>

@code {
    private ReservaVuelo reserva { get; set; } = new ReservaVuelo();
    private List<Cliente> clientes = new();
    private List<Agente> agentes = new();
    private List<Vuelo> vuelos = new();

    private int vueloSeleccionadoId = 0;
    private int cantidadSeleccionada = 1;

    private bool mostrarModalQuitar = false;
    private DetalleReservaVuelo? detalleAQuitar;

    protected override async Task OnInitializedAsync()
    {
        var resultadoClientes = await ClienteService.GetList(c => true);
        clientes = resultadoClientes.IsSuccess ? resultadoClientes.Value! : new List<Cliente>();

        var resultadoAgentes = await AgenteService.GetList(a => true);
        agentes = resultadoAgentes.IsSuccess ? resultadoAgentes.Value! : new List<Agente>();

        var resultadoVuelos = await VueloService.GetList(v => true);
        vuelos = resultadoVuelos.IsSuccess ? resultadoVuelos.Value! : new List<Vuelo>();
    }

    private void AgregarDetalle()
    {
        if (reserva.ClienteId == 0)
        {
            toastService.ShowWarning("Debe seleccionar un cliente antes de agregar un vuelo");
            return;
        }

        if (reserva.AgenteId == 0)
        {
            toastService.ShowWarning("Debe seleccionar un agente antes de agregar un vuelo");
            return;
        }

        if (vueloSeleccionadoId == 0)
        {
            toastService.ShowWarning("Debe seleccionar un vuelo");
            return;
        }

        if (cantidadSeleccionada <= 0)
        {
            toastService.ShowWarning("La cantidad debe ser mayor a 0");
            return;
        }

        var vuelo = vuelos.FirstOrDefault(v => v.VueloId == vueloSeleccionadoId);

        if (vuelo is null)
        {
            toastService.ShowWarning("El vuelo seleccionado ya no existe");
            return;
        }

        if (cantidadSeleccionada > vuelo.AsientosDisponibles)
        {
            toastService.ShowWarning($"El vuelo {vuelo.NumeroVuelo} solo tiene {vuelo.AsientosDisponibles} asientos disponibles");
            return;
        }

        reserva.Detalles.Add(new DetalleReservaVuelo
        {
            VueloId = vueloSeleccionadoId,
            CantidadAsientos = cantidadSeleccionada,
            PrecioUnitario = vuelo.Precio
        });

        vueloSeleccionadoId = 0;
        cantidadSeleccionada = 1;
    }

    private void AbrirModalQuitar(DetalleReservaVuelo detalle)
    {
        detalleAQuitar = detalle;
        mostrarModalQuitar = true;
    }

    private void CerrarModalQuitar()
    {
        mostrarModalQuitar = false;
        detalleAQuitar = null;
    }

    private void ConfirmarQuitarDetalle()
    {
        if (detalleAQuitar is null) return;

        vueloSeleccionadoId = detalleAQuitar.VueloId;
        cantidadSeleccionada = detalleAQuitar.CantidadAsientos;

        reserva.Detalles.Remove(detalleAQuitar);

        mostrarModalQuitar = false;
        detalleAQuitar = null;
    }

    private async Task Guardar()
    {
        if (reserva.ClienteId == 0)
        {
            toastService.ShowWarning("Debe seleccionar un cliente");
            return;
        }

        if (reserva.AgenteId == 0)
        {
            toastService.ShowWarning("Debe seleccionar un agente");
            return;
        }

        if (!reserva.Detalles.Any())
        {
            toastService.ShowWarning("Debe agregar al menos un vuelo al detalle");
            return;
        }

        var resultado = await ReservaVueloService.Guardar(reserva);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("La reserva ha sido creada exitosamente.");
            NavigationManager.NavigateTo("/ReservaVuelos/Index");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError(resultado.Error.Description);
        });
    }
}
