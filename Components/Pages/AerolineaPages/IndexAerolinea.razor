@page "/Aerolineas/Index"
@using ViajaYa.Models
@using ViajaYa.Services
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.AspNetCore.Components.Web
@inject AerolineaService AerolineaService

<PageTitle>Aerolineas - ViajaYa</PageTitle>

<div class="aerolineas-page">

    <div class="aerolineas-back">
        <a href="/" class="back-link">
            <i class="bi bi-arrow-left"></i>
            Volver al inicio
        </a>
    </div>

    <div class="aerolineas-header">
        <div>
            <span class="section-tag">GESTION DE TRANSPORTE</span>
            <h3>Gestion de Aerolineas</h3>
            <p>Consulta y administra las aerolineas registradas.</p>
        </div>

        <a href="/Aerolineas/Create" class="btn-new-aerolinea">
            <i class="bi bi-plus-lg"></i>
            Nueva aerolinea
        </a>
    </div>

    @if (aerolineas is not null)
    {
        <div class="aerolineas-stats">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="bi bi-airplane-engines"></i>
                </div>
                <div>
                    <span>Total de aerolineas</span>
                    <h4>@aerolineas.Count</h4>
                </div>
            </div>
        </div>
    }

    <div class="aerolineas-card">

        <div class="card-heading">
            <div>
                <h5>
                    <i class="bi bi-funnel"></i>
                    Buscar aerolineas
                </h5>
                <p>Selecciona un criterio para filtrar los registros.</p>
            </div>
        </div>

        <div class="search-panel">

            <div class="filter-field">
                <label>Filtrar por</label>
                <select class="form-select" @bind="criterioSeleccionado">
                    <option value="">Elija una opcion</option>
                    <option value="aerolineaId">ID</option>
                    <option value="nombre">Nombre</option>
                    <option value="pais">Pais</option>
                </select>
            </div>

            <div class="search-field">
                <label>Busqueda</label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-search"></i>
                    </span>

                    <input type="text"
                           class="form-control"
                           placeholder="Escribe para buscar..."
                           @bind="textoBusqueda"
                           @bind:event="oninput"
                           @onkeyup="ManejarTecla" />

                    <button type="button" class="btn-search" @onclick="Buscar">
                        Buscar
                    </button>
                </div>
            </div>

            <div class="clear-field">
                <button type="button" class="btn-clear" @onclick="Limpiar">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    Limpiar
                </button>
            </div>

        </div>

        @if (aerolineas is null)
        {
            <div class="loading-state">
                <div class="spinner-border text-primary" role="status"></div>
                <p>Cargando aerolineas...</p>
            </div>
        }
        else if (aerolineas.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="bi bi-airplane"></i>
                </div>
                <h5>No se encontraron aerolineas</h5>
                <p>No hay registros que coincidan con la busqueda.</p>
            </div>
        }
        else
        {
            <div class="records-heading">
                <h6>Listado de aerolineas</h6>
                <span class="records-badge">
                    @aerolineas.Count registros
                </span>
            </div>

            <div class="table-container">
                <QuickGrid Items="@aerolineas.AsQueryable()"
                           Pagination="@paginacion"
                           Class="aerolineas-table">

                    <PropertyColumn Property="@(a => a.AerolineaId)"
                                    Title="ID"
                                    Sortable="true" />

                    <PropertyColumn Property="@(a => a.Nombre)"
                                    Title="Nombre"
                                    Sortable="true" />

                    <PropertyColumn Property="@(a => a.Pais)"
                                    Title="Pais"
                                    Sortable="true" />

                    <TemplateColumn Title="Opciones">
                        <a href="@($"/Aerolineas/Edit/{context.AerolineaId}")"
                           class="btn-edit-aerolinea">
                            <i class="bi bi-pencil-square"></i>
                            Editar
                        </a>
                    </TemplateColumn>

                </QuickGrid>
            </div>

            <div class="table-footer">
                <span>
                    Mostrando @aerolineas.Count aerolineas registradas.
                </span>

                <Paginator State="@paginacion" />
            </div>
        }

    </div>

</div>

@code {
    private List<Aerolinea>? aerolineas;
    private string criterioSeleccionado = "";
    private string textoBusqueda = "";
    private PaginationState paginacion = new PaginationState { ItemsPerPage = 5 };

    private async Task<List<Aerolinea>> ObtenerLista(System.Linq.Expressions.Expression<Func<Aerolinea, bool>> criterio)
    {
        var resultado = await AerolineaService.GetList(criterio);
        return resultado.IsSuccess ? resultado.Value! : new List<Aerolinea>();
    }

    protected override async Task OnInitializedAsync()
    {
        aerolineas = await ObtenerLista(a => true);
    }

    private async Task ManejarTecla(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Buscar();
        }
    }

    private async Task Buscar()
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda) || string.IsNullOrEmpty(criterioSeleccionado))
        {
            aerolineas = await ObtenerLista(a => true);
            return;
        }

        switch (criterioSeleccionado)
        {
            case "aerolineaId":
                if (int.TryParse(textoBusqueda, out int idBuscado))
                    aerolineas = await ObtenerLista(a => a.AerolineaId == idBuscado);
                else
                    aerolineas = new List<Aerolinea>();
                break;

            case "nombre":
                aerolineas = await ObtenerLista(a => a.Nombre.ToLower().Contains(textoBusqueda.ToLower()));
                break;

            case "pais":
                aerolineas = await ObtenerLista(a => a.Pais.ToLower().Contains(textoBusqueda.ToLower()));
                break;

            default:
                aerolineas = await ObtenerLista(a => true);
                break;
        }
    }

    private async Task Limpiar()
    {
        criterioSeleccionado = "";
        textoBusqueda = "";
        aerolineas = await ObtenerLista(a => true);
    }
}