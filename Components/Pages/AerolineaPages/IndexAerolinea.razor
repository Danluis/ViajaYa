@page "/Aerolineas/Index"
@using ViajaYa.Models
@using ViajaYa.Services
@using Microsoft.AspNetCore.Components.QuickGrid
@inject AerolineaService AerolineaService

<PageTitle>Consulta de Aerolineas</PageTitle>

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Consulta de Aerolineas</h5>
            <a href="/Aerolineas/Create" class="btn btn-primary">
                <span class="bi bi-plus-circle"></span> Nueva Aerolinea
            </a>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label"><span class="bi bi-funnel"></span> Filtrar por</label>
                    <select class="form-select" @bind="criterioSeleccionado">
                        <option value="">Elija una opción</option>
                        <option value="aerolineaId">Id</option>
                        <option value="nombre">Nombre</option>
                        <option value="pais">Pais</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Busqueda</label>
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Buscar"
                               @bind="textoBusqueda" @bind:event="oninput"
                               @onkeyup="ManejarTecla" />
                        <button class="btn btn-outline-secondary" @onclick="Buscar">
                            <span class="bi bi-search"></span>
                        </button>
                    </div>
                </div>
            </div>

            @if (aerolineas is null)
            {
                <p>Cargando...</p>
            }
            else
            {
                <QuickGrid Items="@aerolineas.AsQueryable()" Pagination="@paginacion" Class="table table-striped table-hover">
                    <PropertyColumn Property="@(a => a.AerolineaId)" Title="AerolineaId" Sortable="true" />
                    <PropertyColumn Property="@(a => a.Nombre)" Title="Nombre" Sortable="true" />
                    <PropertyColumn Property="@(a => a.Pais)" Title="Pais" Sortable="true" />
                    <TemplateColumn Title="Opciones">
                        <a href="@($"/Aerolineas/Edit/{context.AerolineaId}")" class="btn btn-sm btn-outline-primary">
                            <span class="bi bi-pencil-square"></span> Editar
                        </a>
                    </TemplateColumn>
                </QuickGrid>

                <Paginator State="@paginacion" />

                <p class="text-muted">Cantidad: @aerolineas.Count</p>
            }
        </div>
    </div>
</div>

@code {
    private List<Aerolinea>? aerolineas;
    private string criterioSeleccionado = "";
    private string textoBusqueda = "";
    private PaginationState paginacion = new PaginationState { ItemsPerPage = 5 };

    private async Task<List<Aerolinea>> ObtenerLista(System.Linq.Expressions.Expression<Func<Aerolinea, bool>> criterio)
    {
        var resultado = await AerolineaService.GetList(criterio);
        return resultado.IsSuccess ? resultado.Value! : new List<Aerolinea>();
    }

    protected override async Task OnInitializedAsync()
    {
        aerolineas = await ObtenerLista(a => true);
    }

    private async Task ManejarTecla(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Buscar();
        }
    }

    private async Task Buscar()
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda) || string.IsNullOrEmpty(criterioSeleccionado))
        {
            aerolineas = await ObtenerLista(a => true);
            return;
        }

        switch (criterioSeleccionado)
        {
            case "aerolineaId":
                if (int.TryParse(textoBusqueda, out int idBuscado))
                    aerolineas = await ObtenerLista(a => a.AerolineaId == idBuscado);
                else
                    aerolineas = new List<Aerolinea>();
                break;

            case "nombre":
                aerolineas = await ObtenerLista(a => a.Nombre.ToLower().Contains(textoBusqueda.ToLower()));
                break;

            case "pais":
                aerolineas = await ObtenerLista(a => a.Pais.ToLower().Contains(textoBusqueda.ToLower()));
                break;

            default:
                aerolineas = await ObtenerLista(a => true);
                break;
        }
    }
}
