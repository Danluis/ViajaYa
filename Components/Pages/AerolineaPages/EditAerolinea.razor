@page "/Aerolineas/Edit/{AerolineaId:int}"
@using ViajaYa.Models
@using ViajaYa.Services
@using ViajaYa.Extensors
@inject AerolineaService AerolineaService
@inject ToastService toastService
@inject NavigationManager NavigationManager

<PageTitle>Modificar Aerolinea - ViajaYa</PageTitle>

<div class="aerolinea-edit-page">

    <div class="aerolinea-edit-back">
        <a href="/Aerolineas/Index">
            <i class="bi bi-arrow-left"></i>
            Volver a aerolineas
        </a>
    </div>

    @if (aerolinea.AerolineaId == 0)
    {
        <div class="aerolinea-loading">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p>Cargando informacion de la aerolinea...</p>
        </div>
    }
    else
    {
        <div class="aerolinea-edit-header">
            <div class="header-icon">
                <i class="bi bi-airplane-engines"></i>
            </div>

            <div class="edit-header-info">
                <span class="section-tag">ACTUALIZAR REGISTRO</span>
                <h3>Modificar aerolinea</h3>
                <p>Actualiza la informacion de esta aerolinea.</p>
            </div>

            <span class="aerolinea-id-badge">
                ID: @aerolinea.AerolineaId
            </span>
        </div>

        <div class="aerolinea-edit-card">

            <EditForm Model="aerolinea" OnValidSubmit="@Modificar">
                <DataAnnotationsValidator />

                <div class="aerolinea-edit-body">

                    <div class="aerolinea-section-title">
                        <div>
                            <h5>
                                <i class="bi bi-info-circle"></i>
                                Informacion de la aerolinea
                            </h5>
                            <p>Modifica los datos principales de la aerolinea.</p>
                        </div>
                    </div>

                    <div class="aerolinea-form-divider"></div>

                    <div class="aerolinea-edit-field">
                        <label>Nombre de la aerolinea</label>

                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-airplane"></i>
                            </span>

                            <InputText class="form-control"
                                       placeholder="Ingrese el nombre de la aerolinea"
                                       @bind-Value="aerolinea.Nombre" />
                        </div>

                        <ValidationMessage For="@(() => aerolinea.Nombre)" />
                    </div>

                    <div class="aerolinea-edit-field">
                        <label>Pais de origen</label>

                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-globe-americas"></i>
                            </span>

                            <InputText class="form-control"
                                       placeholder="Ingrese el pais de origen"
                                       @bind-Value="aerolinea.Pais" />
                        </div>

                        <ValidationMessage For="@(() => aerolinea.Pais)" />
                    </div>

                </div>

                <div class="aerolinea-edit-footer">

                    <button type="button"
                            class="aerolinea-btn-delete"
                            @onclick="Eliminar">
                        <i class="bi bi-trash"></i>
                        Eliminar
                    </button>

                    <div class="aerolinea-edit-actions">
                        <a href="/Aerolineas/Index" class="aerolinea-btn-cancel">
                            Cancelar
                        </a>

                        <button type="submit" class="aerolinea-btn-save">
                            <i class="bi bi-floppy"></i>
                            Guardar cambios
                        </button>
                    </div>

                </div>

            </EditForm>

        </div>
    }

</div>

@if (mostrarModal)
{
    <div class="aerolinea-modal">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle"></i>
                        Confirmar eliminacion
                    </h5>

                    <button type="button"
                            class="btn-close"
                            aria-label="Cerrar"
                            @onclick="CerrarModal">
                    </button>
                </div>

                <div class="modal-body">
                    <p class="modal-question">
                        Estas seguro de eliminar esta aerolinea?
                    </p>

                    <p class="modal-description">
                        Esta accion no se puede deshacer.
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="modal-btn-cancel"
                            @onclick="CerrarModal">
                        Cancelar
                    </button>

                    <button type="button"
                            class="modal-btn-delete"
                            @onclick="ConfirmarEliminar">
                        <i class="bi bi-trash"></i>
                        Eliminar
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int AerolineaId { get; set; }

    private Aerolinea aerolinea { get; set; } = new Aerolinea();
    private bool mostrarModal = false;

    protected override async Task OnInitializedAsync()
    {
        var resultado = await AerolineaService.Buscar(AerolineaId);

        if (resultado.IsSuccess && resultado.Value is not null)
        {
            aerolinea = resultado.Value;
        }
        else
        {
            toastService.ShowError("Aerolinea no encontrada");
            NavigationManager.NavigateTo("/Aerolineas/Index");
        }
    }

    private async Task Modificar()
    {
        var resultado = await AerolineaService.Guardar(aerolinea);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("Aerolinea modificada correctamente");
            NavigationManager.NavigateTo("/Aerolineas/Index");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError(resultado.Error.Description);
        });
    }

    private void Eliminar()
    {
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private async Task ConfirmarEliminar()
    {
        mostrarModal = false;

        var resultado = await AerolineaService.Eliminar(aerolinea.AerolineaId);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("Aerolinea eliminada correctamente");
            NavigationManager.NavigateTo("/Aerolineas/Index");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError(resultado.Error.Description);
        });
    }
}