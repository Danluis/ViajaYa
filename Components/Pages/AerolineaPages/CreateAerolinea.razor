@page "/Aerolineas/Create"
@using ViajaYa.Models
@using ViajaYa.Services
@using ViajaYa.Extensors
@inject AerolineaService AerolineaService
@inject ToastService toastService
@inject NavigationManager NavigationManager

<PageTitle>Nueva Aerolinea - ViajaYa</PageTitle>

<div class="aerolinea-form-page">

    <div class="aerolinea-back-link">
        <a href="/Aerolineas/Index">
            <i class="bi bi-arrow-left"></i>
            Volver a aerolineas
        </a>
    </div>

    <div class="aerolinea-form-header">
        <div class="header-icon">
            <i class="bi bi-airplane-engines"></i>
        </div>

        <div>
            <span class="section-tag">NUEVO REGISTRO</span>
            <h3>Registrar aerolinea</h3>
            <p>Completa los datos para registrar una nueva aerolinea.</p>
        </div>
    </div>

    <div class="aerolinea-form-card">

        <EditForm Model="aerolinea" OnValidSubmit="@Guardar">
            <DataAnnotationsValidator />

            <div class="aerolinea-form-body">

                <div class="aerolinea-section-title">
                    <div>
                        <h5>
                            <i class="bi bi-info-circle"></i>
                            Informacion de la aerolinea
                        </h5>
                        <p>Introduce los datos principales de la aerolinea.</p>
                    </div>
                </div>

                <div class="aerolinea-form-divider"></div>

                <div class="aerolinea-field">
                    <label>Nombre de la aerolinea</label>

                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-airplane"></i>
                        </span>

                        <InputText class="form-control"
                                   placeholder="Ingrese el nombre de la aerolinea"
                                   @bind-Value="aerolinea.Nombre" />
                    </div>

                    <ValidationMessage For="@(() => aerolinea.Nombre)" />
                </div>

                <div class="aerolinea-field">
                    <label>Pais de origen</label>

                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-globe-americas"></i>
                        </span>

                        <InputText class="form-control"
                                   placeholder="Ingrese el pais de origen"
                                   @bind-Value="aerolinea.Pais" />
                    </div>

                    <ValidationMessage For="@(() => aerolinea.Pais)" />
                </div>

            </div>

            <div class="aerolinea-form-footer">
                <a href="/Aerolineas/Index" class="aerolinea-btn-cancel">
                    Cancelar
                </a>

                <button type="submit" class="aerolinea-btn-save">
                    <i class="bi bi-floppy"></i>
                    Guardar aerolinea
                </button>
            </div>

        </EditForm>

    </div>

</div>

@code {
    private Aerolinea aerolinea { get; set; } = new Aerolinea();

    private async Task Guardar()
    {
        var resultado = await AerolineaService.Guardar(aerolinea);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("La aerolinea ha sido creada exitosamente.");
            NavigationManager.NavigateTo("/Aerolineas/Index");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError(resultado.Error.Description);
        });
    }
}