@page "/Destinos/Index"
@using ViajaYa.Models
@using ViajaYa.Services
@using Microsoft.AspNetCore.Components.QuickGrid
@inject DestinoService DestinoService
@rendermode InteractiveServer

<PageTitle>Destinos - ViajaYa</PageTitle>

<div class="destinos-page">

    <div class="destinos-header">
        <div>
            <a href="/" class="back-link">
                <i class="bi bi-arrow-left"></i> Volver al inicio
            </a>

            <span class="section-tag">GESTION DEL SISTEMA</span>
            <h1>Destinos</h1>
            <p>Consulta, busca y administra los destinos registrados.</p>
        </div>

        <a href="/Destinos/Create" class="btn-new-destino">
            <i class="bi bi-plus-lg"></i>
            Nuevo destino
        </a>
    </div>

    <div class="destinos-stats">
        <div class="stat-icon">
            <i class="bi bi-geo-alt-fill"></i>
        </div>
        <div>
            <span>Total de destinos</span>
            <strong>@(destinos?.Count ?? 0)</strong>
        </div>
    </div>

    <div class="destinos-card">

        <div class="card-heading">
            <div>
                <h2>Listado de destinos</h2>
                <p>Consulta la informacion de tus destinos.</p>
            </div>

            <span class="records-badge">
                <i class="bi bi-geo-fill"></i>
                @(destinos?.Count ?? 0) registros
            </span>
        </div>

        <div class="search-panel">
            <div class="filter-field">
                <label>Filtrar por</label>
                <select class="form-select" @bind="criterioSeleccionado">
                    <option value="">Elija una opcion</option>
                    <option value="destinoId">ID</option>
                    <option value="ciudad">Ciudad</option>
                    <option value="pais">Pais</option>
                </select>
            </div>

            <div class="search-field">
                <label>Buscar destino</label>
                <div class="input-group">
                    <input type="text"
                           class="form-control"
                           placeholder="Escribe para buscar..."
                           @bind="textoBusqueda"
                           @bind:event="oninput"
                           @onkeyup="ManejarTecla" />

                    <button class="btn-search" @onclick="Buscar">
                        <i class="bi bi-search"></i>
                        Buscar
                    </button>
                </div>
            </div>
        </div>

        @if (destinos is null)
        {
            <div class="loading-state">
                <div class="spinner-border text-primary"></div>
                <p>Cargando destinos...</p>
            </div>
        }
        else if (destinos.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-geo-exclamation"></i>
                <h3>No se encontraron destinos</h3>
                <p>Intenta cambiar los criterios de busqueda.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <QuickGrid Items="@destinos.AsQueryable()"
                           Pagination="@paginacion"
                           Class="destinos-table">

                    <PropertyColumn Property="@(d => d.DestinoId)"
                                    Title="ID"
                                    Sortable="true" />

                    <PropertyColumn Property="@(d => d.Ciudad)"
                                    Title="Ciudad"
                                    Sortable="true" />

                    <PropertyColumn Property="@(d => d.Pais)"
                                    Title="Pais"
                                    Sortable="true" />

                    <PropertyColumn Property="@(d => d.Descripcion)"
                                    Title="Descripcion"
                                    Sortable="false" />

                    <TemplateColumn Title="Opciones">
                        <a href="@($"/Destinos/Edit/{context.DestinoId}")"
                           class="btn-edit-destino">
                            <i class="bi bi-pencil-square"></i>
                            Editar
                        </a>
                    </TemplateColumn>

                </QuickGrid>
            </div>

            <div class="table-footer">
                <span>Mostrando @destinos.Count destinos registrados</span>
                <Paginator State="@paginacion" />
            </div>
        }

    </div>
</div>

@code {
    private List<Destino>? destinos;
    private string criterioSeleccionado = "";
    private string textoBusqueda = "";
    private PaginationState paginacion = new PaginationState { ItemsPerPage = 5 };

    private async Task<List<Destino>> ObtenerLista(System.Linq.Expressions.Expression<Func<Destino, bool>> criterio)
    {
        var resultado = await DestinoService.GetList(criterio);
        return resultado.IsSuccess ? resultado.Value! : new List<Destino>();
    }

    protected override async Task OnInitializedAsync()
    {
        destinos = await ObtenerLista(d => true);
    }

    private async Task ManejarTecla(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Buscar();
        }
    }

    private async Task Buscar()
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda) || string.IsNullOrEmpty(criterioSeleccionado))
        {
            destinos = await ObtenerLista(d => true);
            return;
        }

        switch (criterioSeleccionado)
        {
            case "destinoId":
                if (int.TryParse(textoBusqueda, out int idBuscado))
                    destinos = await ObtenerLista(d => d.DestinoId == idBuscado);
                else
                    destinos = new List<Destino>();
                break;

            case "ciudad":
                destinos = await ObtenerLista(d => d.Ciudad.ToLower().Contains(textoBusqueda.ToLower()));
                break;

            case "pais":
                destinos = await ObtenerLista(d => d.Pais.ToLower().Contains(textoBusqueda.ToLower()));
                break;

            default:
                destinos = await ObtenerLista(d => true);
                break;
        }
    }
}
