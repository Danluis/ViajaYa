@page "/Destinos/Edit/{DestinoId:int}"
@using ViajaYa.Models
@using ViajaYa.Services
@using ViajaYa.Extensors
@inject DestinoService DestinoService
@inject ToastService toastService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Editar Destino - ViajaYa</PageTitle>

<div class="hotel-edit-page">

    <a href="/Destinos/Index" class="hotel-back-link">
        <i class="bi bi-arrow-left me-2"></i>
        Volver a destinos
    </a>

    @if (destino.DestinoId == 0)
    {
        <div class="hotel-loading">
            <div class="spinner-border text-primary"></div>
            <p>Cargando informacion del destino...</p>
        </div>
    }
    else
    {
        <div class="hotel-edit-header">
            <div class="header-icon">
                <i class="bi bi-geo-alt-fill"></i>
            </div>

            <div>
                <h1>Editar destino</h1>
                <p>Modifica la informacion del destino seleccionado.</p>
            </div>
        </div>

        <div class="hotel-edit-card">

            <EditForm Model="destino" OnValidSubmit="@Modificar">
                <DataAnnotationsValidator />

                <div class="hotel-edit-body">

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">

                        <div>
                            <h5 class="hotel-section-title">
                                <i class="bi bi-geo-alt"></i>
                                Informacion del destino
                            </h5>

                            <p class="hotel-section-description">
                                Actualiza los datos principales de este destino.
                            </p>
                        </div>

                        <span class="hotel-id-badge">
                            Destino #@destino.DestinoId
                        </span>

                    </div>

                    <hr class="hotel-form-divider" />

                    <div class="row g-4">

                        <div class="col-12 col-md-6 hotel-field">
                            <label>Ciudad</label>

                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-building"></i>
                                </span>

                                <InputText class="form-control"
                                           placeholder="Ingrese la ciudad"
                                           @bind-Value="destino.Ciudad" />
                            </div>

                            <ValidationMessage For="@(() => destino.Ciudad)" />
                        </div>

                        <div class="col-12 col-md-6 hotel-field">
                            <label>Pais</label>

                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-globe"></i>
                                </span>

                                <InputText class="form-control"
                                           placeholder="Ingrese el pais"
                                           @bind-Value="destino.Pais" />
                            </div>

                            <ValidationMessage For="@(() => destino.Pais)" />
                        </div>

                        <div class="col-12 hotel-field">
                            <label>Descripcion</label>

                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-chat-left-text"></i>
                                </span>

                                <InputTextArea class="form-control"
                                               placeholder="Ingrese una descripcion del destino"
                                               @bind-Value="destino.Descripcion" />
                            </div>

                            <ValidationMessage For="@(() => destino.Descripcion)" />
                        </div>

                    </div>

                </div>

                <div class="hotel-edit-footer">

                    <a href="/Destinos/Index" class="hotel-btn-cancel">
                        <i class="bi bi-x-lg"></i>
                        Cancelar
                    </a>

                    <button type="submit" class="hotel-btn-save">
                        <i class="bi bi-check-lg"></i>
                        Guardar cambios
                    </button>

                    <button type="button" class="hotel-btn-delete" @onclick="Eliminar">
                        <i class="bi bi-trash"></i>
                        Eliminar
                    </button>

                </div>

            </EditForm>

        </div>
    }

</div>

@if (mostrarModal)
{
    <div class="hotel-modal">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Confirmar eliminacion</h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CerrarModal">
                    </button>
                </div>

                <div class="modal-body">
                    <p>Esta seguro de eliminar este destino? Esta accion no se puede deshacer.</p>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CerrarModal">
                        Cancelar
                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            @onclick="ConfirmarEliminar">
                        Eliminar
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int DestinoId { get; set; }

    private Destino destino { get; set; } = new Destino();
    private bool mostrarModal = false;

    protected override async Task OnInitializedAsync()
    {
        var resultado = await DestinoService.Buscar(DestinoId);

        if (resultado.IsSuccess && resultado.Value is not null)
        {
            destino = resultado.Value;
        }
        else
        {
            toastService.ShowError("Destino no encontrado");
            NavigationManager.NavigateTo("/Destinos/Index");
        }
    }

    private async Task Modificar()
    {
        var resultado = await DestinoService.Guardar(destino);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("Destino modificado correctamente");
            NavigationManager.NavigateTo("/Destinos/Index");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError(resultado.Error.Description);
        });
    }

    private void Eliminar()
    {
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private async Task ConfirmarEliminar()
    {
        mostrarModal = false;

        var resultado = await DestinoService.Eliminar(destino.DestinoId);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("Destino eliminado correctamente");
            NavigationManager.NavigateTo("/Destinos/Index");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError(resultado.Error.Description);
        });
    }
}
