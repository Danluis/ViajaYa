@page "/Destinos/Edit/{DestinoId:int}"
@using ViajaYa.Models
@using ViajaYa.Services
@using ViajaYa.Extensors
@inject DestinoService DestinoService
@inject ToastService toastService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Editar Destino - ViajaYa</PageTitle>

<div class="container py-4">

    <div class="mb-4">
        <a href="/Destinos/Index" class="text-decoration-none text-secondary">
            <i class="bi bi-arrow-left me-2"></i>Volver a destinos
        </a>
    </div>

    @if (destino.DestinoId == 0)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="text-muted mt-3">Cargando informacion del destino...</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm mx-auto" style="max-width: 850px;">

            <div class="card-header bg-primary text-white p-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-white bg-opacity-25 rounded-3 p-3">
                        <i class="bi bi-geo-alt fs-3"></i>
                    </div>

                    <div>
                        <h4 class="mb-1 fw-bold">Editar destino</h4>
                        <p class="mb-0 text-white-50">
                            Modifica la informacion del destino seleccionado.
                        </p>
                    </div>
                </div>
            </div>

            <EditForm Model="destino" OnValidSubmit="@Modificar">
                <DataAnnotationsValidator />

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold text-primary mb-0">
                            <i class="bi bi-geo-alt me-2"></i>Informacion del destino
                        </h6>

                        <span class="badge bg-primary-subtle text-primary">
                            Destino #@destino.DestinoId
                        </span>
                    </div>

                    <hr />

                    <div class="row g-4">

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Ciudad</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="bi bi-building"></i>
                                </span>
                                <InputText class="form-control"
                                           placeholder="Ingrese la ciudad"
                                           @bind-Value="destino.Ciudad" />
                            </div>
                            <ValidationMessage For="@(() => destino.Ciudad)" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Pais</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="bi bi-globe"></i>
                                </span>
                                <InputText class="form-control"
                                           placeholder="Ingrese el pais"
                                           @bind-Value="destino.Pais" />
                            </div>
                            <ValidationMessage For="@(() => destino.Pais)" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Descripcion</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="bi bi-chat-left-text"></i>
                                </span>
                                <InputTextArea class="form-control"
                                               placeholder="Ingrese una descripcion del destino"
                                               @bind-Value="destino.Descripcion"
                                               style="border-radius: 0 8px 8px 0;" />
                            </div>
                            <ValidationMessage For="@(() => destino.Descripcion)" />
                        </div>

                    </div>

                </div>

                <div class="card-footer bg-light p-4 d-flex gap-2 justify-content-end">
                    <a href="/Destinos/Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-lg me-2"></i>Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-2"></i>Guardar cambios
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="Eliminar">
                        <i class="bi bi-trash me-2"></i>Eliminar
                    </button>
                </div>

            </EditForm>

        </div>
    }
</div>

<div class="modal fade @(mostrarModal ? "show d-block" : "")" tabindex="-1" style="@(mostrarModal ? "background-color: rgba(0,0,0,0.5);" : "")">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar eliminacion</h5>
                <button type="button" class="btn-close" @onclick="CerrarModal"></button>
            </div>
            <div class="modal-body">
                <p>Esta seguro de eliminar este destino? Esta accion no se puede deshacer.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                <button type="button" class="btn btn-danger" @onclick="ConfirmarEliminar">Eliminar</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int DestinoId { get; set; }

    private Destino destino { get; set; } = new Destino();
    private bool mostrarModal = false;

    protected override async Task OnInitializedAsync()
    {
        var resultado = await DestinoService.Buscar(DestinoId);
        if (resultado.IsSuccess && resultado.Value is not null)
        {
            destino = resultado.Value;
        }
        else
        {
            toastService.ShowError("Destino no encontrado");
            NavigationManager.NavigateTo("/Destinos/Index");
        }
    }

    private async Task Modificar()
    {
        var resultado = await DestinoService.Guardar(destino);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("Destino modificado correctamente");
            NavigationManager.NavigateTo("/Destinos/Index");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError(resultado.Error.Description);
        });
    }

    private void Eliminar()
    {
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private async Task ConfirmarEliminar()
    {
        mostrarModal = false;

        var resultado = await DestinoService.Eliminar(destino.DestinoId);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("Destino eliminado correctamente");
            NavigationManager.NavigateTo("/Destinos/Index");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError(resultado.Error.Description);
        });
    }
}
