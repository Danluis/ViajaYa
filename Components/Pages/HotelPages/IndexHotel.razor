@page "/Hoteles/Index"
@using ViajaYa.Models
@using ViajaYa.Services
@using Microsoft.AspNetCore.Components.QuickGrid
@inject HotelService HotelService
@rendermode InteractiveServer

<PageTitle>Hoteles - ViajaYa</PageTitle>

<div class="hoteles-page">

    <div class="hoteles-header">
        <div>
            <a href="/" class="back-link">
                <i class="bi bi-arrow-left"></i> Volver al inicio
            </a>

            <span class="section-tag">GESTION DEL SISTEMA</span>
            <h1>Hoteles</h1>
            <p>Consulta, busca y administra los hoteles registrados.</p>
        </div>

        <a href="/Hoteles/Create" class="btn-new-hotel">
            <i class="bi bi-plus-lg"></i>
            Nuevo hotel
        </a>
    </div>

    <div class="hoteles-stats">
        <div class="stat-icon">
            <i class="bi bi-building-fill"></i>
        </div>
        <div>
            <span>Total de hoteles</span>
            <strong>@(hoteles?.Count ?? 0)</strong>
        </div>
    </div>

    <div class="hoteles-card">

        <div class="card-heading">
            <div>
                <h2>Listado de hoteles</h2>
                <p>Consulta la informacion de tus hoteles.</p>
            </div>

            <span class="records-badge">
                <i class="bi bi-building"></i>
                @(hoteles?.Count ?? 0) registros
            </span>
        </div>

        <div class="search-panel">
            <div class="filter-field">
                <label>Filtrar por</label>
                <select class="form-select" @bind="criterioSeleccionado">
                    <option value="">Elija una opcion</option>
                    <option value="hotelId">ID</option>
                    <option value="nombre">Nombre</option>
                    <option value="direccion">Direccion</option>
                    <option value="destino">Destino</option>
                </select>
            </div>

            <div class="search-field">
                <label>Buscar hotel</label>
                <div class="input-group">
                    <input type="text"
                           class="form-control"
                           placeholder="Escribe para buscar..."
                           @bind="textoBusqueda"
                           @bind:event="oninput"
                           @onkeyup="ManejarTecla" />

                    <button class="btn-search" @onclick="Buscar">
                        <i class="bi bi-search"></i>
                        Buscar
                    </button>
                </div>
            </div>
        </div>

        @if (hoteles is null)
        {
            <div class="loading-state">
                <div class="spinner-border text-primary"></div>
                <p>Cargando hoteles...</p>
            </div>
        }
        else if (hoteles.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-building-exclamation"></i>
                <h3>No se encontraron hoteles</h3>
                <p>Intenta cambiar los criterios de busqueda.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <QuickGrid Items="@hoteles.AsQueryable()"
                           Pagination="@paginacion"
                           Class="hoteles-table">

                    <PropertyColumn Property="@(h => h.HotelId)"
                                    Title="ID"
                                    Sortable="true" />

                    <PropertyColumn Property="@(h => h.Nombre)"
                                    Title="Nombre"
                                    Sortable="true" />

                    <PropertyColumn Property="@(h => h.Direccion)"
                                    Title="Direccion"
                                    Sortable="true" />

                    <TemplateColumn Title="Destino">
                        @if (context.Destino is not null)
                        {
                            <span>@context.Destino.Ciudad, @context.Destino.Pais</span>
                        }
                    </TemplateColumn>

                    <PropertyColumn Property="@(h => h.Categoria)"
                                    Title="Categoria"
                                    Sortable="true" />

                    <PropertyColumn Property="@(h => h.HabitacionesDisponibles)"
                                    Title="Habitaciones"
                                    Sortable="true" />

                    <TemplateColumn Title="Precio/Noche">
                        @context.PrecioPorNoche.ToString("C")
                    </TemplateColumn>

                    <TemplateColumn Title="Opciones">
                        <a href="@($"/Hoteles/Edit/{context.HotelId}")"
                           class="btn-edit-hotel">
                            <i class="bi bi-pencil-square"></i>
                            Editar
                        </a>
                    </TemplateColumn>

                </QuickGrid>
            </div>

            <div class="table-footer">
                <span>Mostrando @hoteles.Count hoteles registrados</span>
                <Paginator State="@paginacion" />
            </div>
        }

    </div>
</div>

@code {
    private List<Hotel>? hoteles;
    private string criterioSeleccionado = "";
    private string textoBusqueda = "";
    private PaginationState paginacion = new PaginationState { ItemsPerPage = 5 };

    private async Task<List<Hotel>> ObtenerLista(System.Linq.Expressions.Expression<Func<Hotel, bool>> criterio)
    {
        var resultado = await HotelService.GetList(criterio);
        return resultado.IsSuccess ? resultado.Value! : new List<Hotel>();
    }

    protected override async Task OnInitializedAsync()
    {
        hoteles = await ObtenerLista(h => true);
    }

    private async Task ManejarTecla(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Buscar();
        }
    }

    private async Task Buscar()
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda) || string.IsNullOrEmpty(criterioSeleccionado))
        {
            hoteles = await ObtenerLista(h => true);
            return;
        }

        switch (criterioSeleccionado)
        {
            case "hotelId":
                if (int.TryParse(textoBusqueda, out int idBuscado))
                    hoteles = await ObtenerLista(h => h.HotelId == idBuscado);
                else
                    hoteles = new List<Hotel>();
                break;

            case "nombre":
                hoteles = await ObtenerLista(h => h.Nombre.ToLower().Contains(textoBusqueda.ToLower()));
                break;

            case "direccion":
                hoteles = await ObtenerLista(h => h.Direccion.ToLower().Contains(textoBusqueda.ToLower()));
                break;

            case "destino":
                hoteles = await ObtenerLista(h => h.Destino != null && h.Destino.Ciudad.ToLower().Contains(textoBusqueda.ToLower()));
                break;

            default:
                hoteles = await ObtenerLista(h => true);
                break;
        }
    }
}
