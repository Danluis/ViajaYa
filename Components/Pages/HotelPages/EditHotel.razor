@page "/Hoteles/Edit/{HotelId:int}"
@using ViajaYa.Models
@using ViajaYa.Services
@using ViajaYa.Extensors
@inject HotelService HotelService
@inject DestinoService DestinoService
@inject ToastService toastService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Editar Hotel - ViajaYa</PageTitle>

<div class="container py-4">

    <div class="mb-4">
        <a href="/Hoteles/Index" class="text-decoration-none text-secondary">
            <i class="bi bi-arrow-left me-2"></i>Volver a hoteles
        </a>
    </div>

    @if (hotel.HotelId == 0)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="text-muted mt-3">Cargando informacion del hotel...</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm mx-auto" style="max-width: 850px;">

            <div class="card-header bg-primary text-white p-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-white bg-opacity-25 rounded-3 p-3">
                        <i class="bi bi-building fs-3"></i>
                    </div>

                    <div>
                        <h4 class="mb-1 fw-bold">Editar hotel</h4>
                        <p class="mb-0 text-white-50">
                            Modifica la informacion del hotel seleccionado.
                        </p>
                    </div>
                </div>
            </div>

            <EditForm Model="hotel" OnValidSubmit="@Modificar">
                <DataAnnotationsValidator />

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold text-primary mb-0">
                            <i class="bi bi-info-circle me-2"></i>Informacion basica
                        </h6>

                        <span class="badge bg-primary-subtle text-primary">
                            Hotel #@hotel.HotelId
                        </span>
                    </div>

                    <hr />

                    <div class="row g-4">

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Nombre del hotel</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="bi bi-building"></i>
                                </span>
                                <InputText class="form-control"
                                           placeholder="Ingrese el nombre"
                                           @bind-Value="hotel.Nombre" />
                            </div>
                            <ValidationMessage For="@(() => hotel.Nombre)" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Direccion</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="bi bi-geo-alt"></i>
                                </span>
                                <InputText class="form-control"
                                           placeholder="Ingrese la direccion"
                                           @bind-Value="hotel.Direccion" />
                            </div>
                            <ValidationMessage For="@(() => hotel.Direccion)" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Destino</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="bi bi-geo-alt-fill"></i>
                                </span>
                                <InputSelect class="form-select" @bind-Value="hotel.DestinoId">
                                    <option value="0">Seleccione un destino</option>
                                    @foreach (var d in destinos)
                                    {
                                        <option value="@d.DestinoId">@d.Ciudad, @d.Pais</option>
                                    }
                                </InputSelect>
                            </div>
                            <ValidationMessage For="@(() => hotel.DestinoId)" />
                        </div>

                    </div>

                    <div class="mb-4 mt-5">
                        <h6 class="fw-bold text-primary">
                            <i class="bi bi-graph-up me-2"></i>Detalles del hotel
                        </h6>
                        <hr />
                    </div>

                    <div class="row g-4">

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Categoria (estrellas)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="bi bi-star-fill"></i>
                                </span>
                                <InputNumber class="form-control"
                                             placeholder="1-5"
                                             @bind-Value="hotel.Categoria" />
                            </div>
                            <ValidationMessage For="@(() => hotel.Categoria)" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Habitaciones disponibles</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="bi bi-door-closed"></i>
                                </span>
                                <InputNumber class="form-control"
                                             placeholder="Cantidad"
                                             @bind-Value="hotel.HabitacionesDisponibles" />
                            </div>
                            <ValidationMessage For="@(() => hotel.HabitacionesDisponibles)" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Precio por noche</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="bi bi-currency-dollar"></i>
                                </span>
                                <InputNumber class="form-control"
                                             placeholder="0.00"
                                             @bind-Value="hotel.PrecioPorNoche" />
                            </div>
                            <ValidationMessage For="@(() => hotel.PrecioPorNoche)" />
                        </div>

                    </div>

                </div>

                <div class="card-footer bg-light p-4 d-flex gap-2 justify-content-end">
                    <a href="/Hoteles/Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-lg me-2"></i>Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-2"></i>Guardar cambios
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="Eliminar">
                        <i class="bi bi-trash me-2"></i>Eliminar
                    </button>
                </div>

            </EditForm>

        </div>
    }
</div>

<div class="modal fade @(mostrarModal ? "show d-block" : "")" tabindex="-1" style="@(mostrarModal ? "background-color: rgba(0,0,0,0.5);" : "")">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar eliminacion</h5>
                <button type="button" class="btn-close" @onclick="CerrarModal"></button>
            </div>
            <div class="modal-body">
                <p>Esta seguro de eliminar este hotel? Esta accion no se puede deshacer.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                <button type="button" class="btn btn-danger" @onclick="ConfirmarEliminar">Eliminar</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int HotelId { get; set; }

    private Hotel hotel { get; set; } = new Hotel();
    private List<Destino> destinos = new();
    private bool mostrarModal = false;

    protected override async Task OnInitializedAsync()
    {
        var resultadoDestinos = await DestinoService.GetList(d => true);
        destinos = resultadoDestinos.IsSuccess ? resultadoDestinos.Value! : new List<Destino>();

        var resultado = await HotelService.Buscar(HotelId);
        if (resultado.IsSuccess && resultado.Value is not null)
        {
            hotel = resultado.Value;
        }
        else
        {
            toastService.ShowError("Hotel no encontrado");
            NavigationManager.NavigateTo("/Hoteles/Index");
        }
    }

    private async Task Modificar()
    {
        var resultado = await HotelService.Guardar(hotel);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("Hotel modificado correctamente");
            NavigationManager.NavigateTo("/Hoteles/Index");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError(resultado.Error.Description);
        });
    }

    private void Eliminar()
    {
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private async Task ConfirmarEliminar()
    {
        mostrarModal = false;

        var resultado = await HotelService.Eliminar(hotel.HotelId);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("Hotel eliminado correctamente");
            NavigationManager.NavigateTo("/Hoteles/Index");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError(resultado.Error.Description);
        });
    }
}
