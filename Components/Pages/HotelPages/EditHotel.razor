@page "/Hoteles/Edit/{HotelId:int}"
@using ViajaYa.Models
@using ViajaYa.Services
@using ViajaYa.Extensors
@inject HotelService HotelService
@inject DestinoService DestinoService
@inject ToastService toastService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Editar Hotel - ViajaYa</PageTitle>

<div class="hotel-edit-page">

    <a href="/Hoteles/Index" class="hotel-back-link">
        <i class="bi bi-arrow-left me-2"></i>Volver a hoteles
    </a>

    @if (hotel.HotelId == 0)
    {
        <div class="hotel-loading">
            <div class="spinner-border"></div>
            <p class="mt-3">Cargando informacion del hotel...</p>
        </div>
    }
    else
    {
        <div class="hotel-edit-header">
            <div class="header-icon">
                <i class="bi bi-building"></i>
            </div>

            <div>
                <h1>Editar hotel</h1>
                <p>Modifica la informacion del hotel seleccionado.</p>
            </div>
        </div>

        <div class="hotel-edit-card">

            <EditForm Model="hotel" OnValidSubmit="@Modificar">
                <DataAnnotationsValidator />

                <div class="hotel-edit-body">

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div>
                            <h5 class="hotel-section-title">
                                <i class="bi bi-info-circle"></i>
                                Informacion basica
                            </h5>
                            <p class="hotel-section-description">
                                Actualiza los datos principales del establecimiento.
                            </p>
                        </div>

                        <span class="hotel-id-badge">
                            Hotel #@hotel.HotelId
                        </span>
                    </div>

                    <hr class="hotel-form-divider" />

                    <div class="row g-3">

                        <div class="col-12 col-md-6 hotel-field">
                            <label>Nombre del hotel</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-building"></i>
                                </span>
                                <InputText class="form-control"
                                           placeholder="Ingrese el nombre"
                                           @bind-Value="hotel.Nombre" />
                            </div>
                            <ValidationMessage For="@(() => hotel.Nombre)" />
                        </div>

                        <div class="col-12 col-md-6 hotel-field">
                            <label>Direccion</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-geo-alt"></i>
                                </span>
                                <InputText class="form-control"
                                           placeholder="Ingrese la direccion"
                                           @bind-Value="hotel.Direccion" />
                            </div>
                            <ValidationMessage For="@(() => hotel.Direccion)" />
                        </div>

                        <div class="col-12 hotel-field">
                            <label>Destino</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-geo-alt-fill"></i>
                                </span>
                                <InputSelect class="form-select" @bind-Value="hotel.DestinoId">
                                    <option value="0">Seleccione un destino</option>
                                    @foreach (var d in destinos)
                                    {
                                        <option value="@d.DestinoId">@d.Ciudad, @d.Pais</option>
                                    }
                                </InputSelect>
                            </div>
                            <ValidationMessage For="@(() => hotel.DestinoId)" />
                        </div>

                    </div>

                    <hr class="hotel-form-divider" />

                    <h5 class="hotel-section-title">
                        <i class="bi bi-graph-up"></i>
                        Detalles del hotel
                    </h5>

                    <p class="hotel-section-description">
                        Modifica la categoria, disponibilidad y precio.
                    </p>

                    <div class="row g-3">

                        <div class="col-12 col-md-6 hotel-field">
                            <label>Categoria (estrellas)</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-star-fill"></i>
                                </span>
                                <InputNumber class="form-control"
                                             placeholder="1-5"
                                             @bind-Value="hotel.Categoria" />
                            </div>
                            <ValidationMessage For="@(() => hotel.Categoria)" />
                        </div>

                        <div class="col-12 col-md-6 hotel-field">
                            <label>Habitaciones disponibles</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-door-closed"></i>
                                </span>
                                <InputNumber class="form-control"
                                             placeholder="Cantidad"
                                             @bind-Value="hotel.HabitacionesDisponibles" />
                            </div>
                            <ValidationMessage For="@(() => hotel.HabitacionesDisponibles)" />
                        </div>

                        <div class="col-12 hotel-field">
                            <label>Precio por noche</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-currency-dollar"></i>
                                </span>
                                <InputNumber class="form-control"
                                             placeholder="0.00"
                                             @bind-Value="hotel.PrecioPorNoche" />
                            </div>
                            <ValidationMessage For="@(() => hotel.PrecioPorNoche)" />
                        </div>

                    </div>

                </div>

                <div class="hotel-edit-footer">
                    <a href="/Hoteles/Index" class="hotel-btn-cancel">
                        <i class="bi bi-x-lg"></i>
                        Cancelar
                    </a>

                    <button type="submit" class="hotel-btn-save">
                        <i class="bi bi-check-lg"></i>
                        Guardar cambios
                    </button>

                    <button type="button" class="hotel-btn-delete" @onclick="Eliminar">
                        <i class="bi bi-trash"></i>
                        Eliminar
                    </button>
                </div>

            </EditForm>

        </div>
    }
</div>

@if (mostrarModal)
{
    <div class="hotel-modal modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5);">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle text-danger me-2"></i>
                        Confirmar eliminacion
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CerrarModal">
                    </button>
                </div>

                <div class="modal-body">
                    <p>
                        Esta seguro de eliminar este hotel?
                        Esta accion no se puede deshacer.
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            @onclick="CerrarModal">
                        Cancelar
                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            @onclick="ConfirmarEliminar">
                        <i class="bi bi-trash me-2"></i>
                        Eliminar
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int HotelId { get; set; }

    private Hotel hotel { get; set; } = new Hotel();
    private List<Destino> destinos = new();
    private bool mostrarModal = false;

    protected override async Task OnInitializedAsync()
    {
        var resultadoDestinos = await DestinoService.GetList(d => true);
        destinos = resultadoDestinos.IsSuccess ? resultadoDestinos.Value! : new List<Destino>();

        var resultado = await HotelService.Buscar(HotelId);

        if (resultado.IsSuccess && resultado.Value is not null)
        {
            hotel = resultado.Value;
        }
        else
        {
            toastService.ShowError("Hotel no encontrado");
            NavigationManager.NavigateTo("/Hoteles/Index");
        }
    }

    private async Task Modificar()
    {
        var resultado = await HotelService.Guardar(hotel);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("Hotel modificado correctamente");
            NavigationManager.NavigateTo("/Hoteles/Index");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError(resultado.Error.Description);
        });
    }

    private void Eliminar()
    {
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private async Task ConfirmarEliminar()
    {
        mostrarModal = false;

        var resultado = await HotelService.Eliminar(hotel.HotelId);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("Hotel eliminado correctamente");
            NavigationManager.NavigateTo("/Hoteles/Index");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError(resultado.Error.Description);
        });
    }
}
