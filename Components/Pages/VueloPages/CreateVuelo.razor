@page "/Vuelos/Create"
@using ViajaYa.Models
@using ViajaYa.Services
@using ViajaYa.Extensors
@inject VueloService VueloService
@inject AerolineaService AerolineaService
@inject DestinoService DestinoService
@inject ToastService toastService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Crear vuelo - ViajaYa</PageTitle>

<div class="container-fluid py-4 px-3 px-lg-4">

    <div class="mb-4">
        <a href="/Vuelos/Index" class="text-decoration-none text-secondary small">
            <i class="bi bi-arrow-left me-2"></i>Volver a vuelos
        </a>

        <div class="mt-3">
            <span class="badge bg-primary bg-opacity-10 text-primary mb-2">
                GESTION DE VUELOS
            </span>
            <h2 class="fw-bold mb-1">Registrar nuevo vuelo</h2>
            <p class="text-muted mb-0">
                Completa la informacion para registrar un nuevo vuelo en el sistema.
            </p>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 p-4">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 bg-primary bg-opacity-10 p-3">
                    <i class="bi bi-airplane-engines text-primary fs-3"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-1">Informacion del vuelo</h5>
                    <p class="text-muted small mb-0">
                        Los campos marcados deben completarse correctamente.
                    </p>
                </div>
            </div>
        </div>

        <EditForm Model="vuelo" OnValidSubmit="@Guardar">
            <DataAnnotationsValidator />

            <div class="card-body p-4">
                <div class="row g-4">

                    <div class="col-12">
                        <h6 class="fw-bold text-primary mb-0">
                            <i class="bi bi-ticket-perforated me-2"></i>Datos generales
                        </h6>
                        <hr class="mt-2" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">Numero de vuelo</label>
                        <InputText class="form-control"
                                   placeholder="Ejemplo: AV123"
                                   @bind-Value="vuelo.NumeroVuelo" />
                        <ValidationMessage For="@(() => vuelo.NumeroVuelo)" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">Aerolinea</label>
                        <InputSelect class="form-select" @bind-Value="vuelo.AerolineaId">
                            <option value="0">Seleccione una aerolinea</option>
                            @foreach (var a in aerolineas)
                            {
                                <option value="@a.AerolineaId">@a.Nombre</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => vuelo.AerolineaId)" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">Destino</label>
                        <InputSelect class="form-select" @bind-Value="vuelo.DestinoId">
                            <option value="0">Seleccione un destino</option>
                            @foreach (var d in destinos)
                            {
                                <option value="@d.DestinoId">@d.Ciudad, @d.Pais</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => vuelo.DestinoId)" />
                    </div>

                    <div class="col-12">
                        <h6 class="fw-bold text-primary mb-0 mt-2">
                            <i class="bi bi-calendar-event me-2"></i>Itinerario
                        </h6>
                        <hr class="mt-2" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">Fecha de salida</label>
                        <InputDate class="form-control" @bind-Value="vuelo.FechaSalida" />
                        <ValidationMessage For="@(() => vuelo.FechaSalida)" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">Fecha de llegada</label>
                        <InputDate class="form-control" @bind-Value="vuelo.FechaLlegada" />
                        <ValidationMessage For="@(() => vuelo.FechaLlegada)" />
                    </div>

                    <div class="col-12">
                        <h6 class="fw-bold text-primary mb-0 mt-2">
                            <i class="bi bi-cash-coin me-2"></i>Disponibilidad y precio
                        </h6>
                        <hr class="mt-2" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">Asientos disponibles</label>
                        <InputNumber class="form-control"
                                     placeholder="Cantidad de asientos"
                                     @bind-Value="vuelo.AsientosDisponibles" />
                        <ValidationMessage For="@(() => vuelo.AsientosDisponibles)" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">Precio</label>
                        <InputNumber class="form-control"
                                     placeholder="Precio del vuelo"
                                     @bind-Value="vuelo.Precio" />
                        <ValidationMessage For="@(() => vuelo.Precio)" />
                    </div>

                </div>
            </div>

            <div class="card-footer bg-white border-0 p-4">
                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                    <a href="/Vuelos/Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-x-circle me-2"></i>Cancelar
                    </a>

                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-floppy me-2"></i>Guardar vuelo
                    </button>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private Vuelo vuelo { get; set; } = new Vuelo();
    private List<Aerolinea> aerolineas = new();
    private List<Destino> destinos = new();

    protected override async Task OnInitializedAsync()
    {
        var resultadoAerolineas = await AerolineaService.GetList(a => true);
        aerolineas = resultadoAerolineas.IsSuccess ? resultadoAerolineas.Value! : new List<Aerolinea>();

        var resultadoDestinos = await DestinoService.GetList(d => true);
        destinos = resultadoDestinos.IsSuccess ? resultadoDestinos.Value! : new List<Destino>();
    }

    private async Task Guardar()
    {
        if (vuelo.AerolineaId == 0)
        {
            toastService.ShowWarning("Debe seleccionar una aerolinea");
            return;
        }

        if (vuelo.DestinoId == 0)
        {
            toastService.ShowWarning("Debe seleccionar un destino");
            return;
        }

        var resultado = await VueloService.Guardar(vuelo);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("El vuelo ha sido creado exitosamente.");
            NavigationManager.NavigateTo("/Vuelos/Index");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError(resultado.Error.Description);
        });
    }
}
