@page "/Vuelos/Edit/{VueloId:int}"
@using ViajaYa.Models
@using ViajaYa.Services
@using ViajaYa.Extensors
@inject VueloService VueloService
@inject AerolineaService AerolineaService
@inject DestinoService DestinoService
@inject ToastService toastService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Modificar vuelo - ViajaYa</PageTitle>

<div class="vuelo-edit-page">
    <div class="vuelo-edit-heading">
        <a href="/Vuelos/Index" class="vuelo-edit-back">
            <i class="bi bi-arrow-left me-2"></i>Volver a vuelos
        </a>

        <div class="mt-3">
            <span class="vuelo-edit-tag">GESTION DE VUELOS</span>
            <h2>Modificar vuelo</h2>
            <p>Actualiza la informacion del vuelo seleccionado.</p>
        </div>
    </div>

    @if (vuelo is null)
    {
        <div class="vuelo-edit-loading">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p>Cargando informacion del vuelo...</p>
        </div>
    }
    else
    {
        <section class="vuelo-edit-card">
            <div class="vuelo-edit-card-header">
                <div class="vuelo-edit-icon">
                    <i class="bi bi-airplane-engines"></i>
                </div>
                <div>
                    <h5>Informacion del vuelo</h5>
                    <p>Modifica los datos necesarios y guarda los cambios.</p>
                </div>

                <span class="vuelo-edit-id">Vuelo #@vuelo.VueloId</span>
            </div>

            <EditForm Model="vuelo" OnValidSubmit="@Modificar">
                <DataAnnotationsValidator />

                <div class="vuelo-edit-card-body">
                    <div class="row g-4">

                        <div class="col-12">
                            <h6 class="vuelo-edit-section-title">
                                <i class="bi bi-ticket-perforated me-2"></i>Datos generales
                            </h6>
                            <hr class="vuelo-edit-divider" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="vuelo-edit-label">Numero de vuelo</label>
                            <InputText class="form-control vuelo-edit-input"
                                       @bind-Value="vuelo.NumeroVuelo" />
                            <ValidationMessage For="@(() => vuelo.NumeroVuelo)" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="vuelo-edit-label">Aerolinea</label>
                            <InputSelect class="form-select vuelo-edit-input" @bind-Value="vuelo.AerolineaId">
                                <option value="0">Seleccione una aerolinea</option>
                                @foreach (var a in aerolineas)
                                {
                                    <option value="@a.AerolineaId">@a.Nombre</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => vuelo.AerolineaId)" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="vuelo-edit-label">Destino</label>
                            <InputSelect class="form-select vuelo-edit-input" @bind-Value="vuelo.DestinoId">
                                <option value="0">Seleccione un destino</option>
                                @foreach (var d in destinos)
                                {
                                    <option value="@d.DestinoId">@d.Ciudad, @d.Pais</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => vuelo.DestinoId)" />
                        </div>

                        <div class="col-12">
                            <h6 class="vuelo-edit-section-title vuelo-edit-section-spaced">
                                <i class="bi bi-calendar-event me-2"></i>Itinerario
                            </h6>
                            <hr class="vuelo-edit-divider" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="vuelo-edit-label">Fecha de salida</label>
                            <InputDate class="form-control vuelo-edit-input"
                                       @bind-Value="vuelo.FechaSalida" />
                            <ValidationMessage For="@(() => vuelo.FechaSalida)" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="vuelo-edit-label">Fecha de llegada</label>
                            <InputDate class="form-control vuelo-edit-input"
                                       @bind-Value="vuelo.FechaLlegada" />
                            <ValidationMessage For="@(() => vuelo.FechaLlegada)" />
                        </div>

                        <div class="col-12">
                            <h6 class="vuelo-edit-section-title vuelo-edit-section-spaced">
                                <i class="bi bi-cash-coin me-2"></i>Disponibilidad y precio
                            </h6>
                            <hr class="vuelo-edit-divider" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="vuelo-edit-label">Asientos disponibles</label>
                            <InputNumber class="form-control vuelo-edit-input"
                                         @bind-Value="vuelo.AsientosDisponibles" />
                            <ValidationMessage For="@(() => vuelo.AsientosDisponibles)" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="vuelo-edit-label">Precio</label>
                            <InputNumber class="form-control vuelo-edit-input"
                                         @bind-Value="vuelo.Precio" />
                            <ValidationMessage For="@(() => vuelo.Precio)" />
                        </div>

                    </div>
                </div>

                <div class="vuelo-edit-card-footer">
                    <button type="button"
                            class="btn vuelo-edit-btn-delete"
                            @onclick="Eliminar">
                        <i class="bi bi-trash me-2"></i>Eliminar vuelo
                    </button>

                    <div class="vuelo-edit-footer-actions">
                        <a href="/Vuelos/Index" class="btn vuelo-edit-btn-cancel">
                            <i class="bi bi-x-circle me-2"></i>Cancelar
                        </a>

                        <button type="submit" class="btn vuelo-edit-btn-save">
                            <i class="bi bi-floppy me-2"></i>Guardar cambios
                        </button>
                    </div>
                </div>
            </EditForm>
        </section>
    }
</div>

@if (mostrarModal)
{
    <div class="vuelo-edit-modal-backdrop">
        <div class="modal-dialog modal-dialog-centered vuelo-edit-modal-dialog">
            <div class="modal-content vuelo-edit-modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle text-danger me-2"></i>
                        Confirmar eliminacion
                    </h5>
                    <button type="button"
                            class="btn-close"
                            aria-label="Cerrar"
                            @onclick="CerrarModal">
                    </button>
                </div>

                <div class="modal-body">
                    <p class="mb-0">
                        Esta seguro de eliminar este vuelo? Esta accion no se puede deshacer.
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn vuelo-edit-btn-cancel"
                            @onclick="CerrarModal">
                        Cancelar
                    </button>

                    <button type="button"
                            class="btn vuelo-edit-btn-confirm-delete"
                            @onclick="ConfirmarEliminar">
                        <i class="bi bi-trash me-2"></i>Eliminar
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int VueloId { get; set; }

    private Vuelo vuelo { get; set; } = new Vuelo();
    private List<Aerolinea> aerolineas = new();
    private List<Destino> destinos = new();
    private bool mostrarModal = false;

    protected override async Task OnInitializedAsync()
    {
        var resultadoAerolineas = await AerolineaService.GetList(a => true);
        aerolineas = resultadoAerolineas.IsSuccess ? resultadoAerolineas.Value! : new List<Aerolinea>();

        var resultadoDestinos = await DestinoService.GetList(d => true);
        destinos = resultadoDestinos.IsSuccess ? resultadoDestinos.Value! : new List<Destino>();

        var resultado = await VueloService.Buscar(VueloId);

        if (resultado.IsSuccess && resultado.Value is not null)
        {
            vuelo = resultado.Value;
        }
        else
        {
            toastService.ShowError("Vuelo no encontrado");
            NavigationManager.NavigateTo("/Vuelos/Index");
        }
    }

    private async Task Modificar()
    {
        var resultado = await VueloService.Guardar(vuelo);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("Vuelo modificado correctamente");
            NavigationManager.NavigateTo("/Vuelos/Index");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError(resultado.Error.Description);
        });
    }

    private void Eliminar()
    {
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private async Task ConfirmarEliminar()
    {
        mostrarModal = false;

        var resultado = await VueloService.Eliminar(vuelo.VueloId);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("Vuelo eliminado correctamente");
            NavigationManager.NavigateTo("/Vuelos/Index");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError(resultado.Error.Description);
        });
    }
}