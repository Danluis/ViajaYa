@page "/Vuelos/Index"
@using ViajaYa.Models
@using ViajaYa.Services
@using Microsoft.AspNetCore.Components.QuickGrid
@inject VueloService VueloService
@rendermode InteractiveServer

<PageTitle>Vuelos - ViajaYa</PageTitle>

<div class="container-fluid py-4 px-3 px-lg-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <a href="/" class="text-decoration-none text-secondary small">
                <i class="bi bi-arrow-left me-2"></i>Volver al inicio
            </a>

            <div class="mt-3">
                <span class="badge bg-primary bg-opacity-10 text-primary mb-2">
                    GESTION DEL SISTEMA
                </span>

                <h2 class="fw-bold mb-1">Gestion de vuelos</h2>
                <p class="text-muted mb-0">
                    Consulta, busca y administra los vuelos registrados.
                </p>
            </div>
        </div>

        <a href="/Vuelos/Create" class="btn btn-primary px-4 py-2">
            <i class="bi bi-plus-circle me-2"></i>Nuevo vuelo
        </a>

    </div>

    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-1">Total de vuelos</p>
                            <h3 class="fw-bold mb-0">
                                @(vuelos?.Count ?? 0)
                            </h3>
                        </div>

                        <div class="rounded-3 bg-primary bg-opacity-10 p-3">
                            <i class="bi bi-airplane-engines text-primary fs-3"></i>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white border-0 p-4">
            <h5 class="fw-bold mb-1">
                <i class="bi bi-funnel text-primary me-2"></i>Busqueda y filtros
            </h5>
            <p class="text-muted small mb-0">
                Utiliza los filtros para encontrar los vuelos que necesitas.
            </p>
        </div>

        <div class="card-body px-4 pb-4">

            <div class="row g-3">

                <div class="col-12 col-md-4">
                    <label class="form-label fw-semibold">Filtrar por</label>

                    <select class="form-select" @bind="criterioSeleccionado">
                        <option value="">Elija una opcion</option>
                        <option value="vueloId">ID del vuelo</option>
                        <option value="numeroVuelo">Numero de vuelo</option>
                        <option value="aerolinea">Aerolinea</option>
                        <option value="destino">Destino</option>
                    </select>
                </div>

                <div class="col-12 col-md-8">
                    <label class="form-label fw-semibold">Buscar vuelo</label>

                    <div class="input-group">
                        <span class="input-group-text bg-light">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               class="form-control"
                               placeholder="Escribe el dato que deseas buscar..."
                               @bind="textoBusqueda"
                               @bind:event="oninput"
                               @onkeyup="ManejarTecla" />

                        <button type="button"
                                class="btn btn-primary"
                                @onclick="Buscar">
                            Buscar
                        </button>
                    </div>
                </div>

                <div class="col-12 col-md-5">
                    <label class="form-label fw-semibold">Fecha de salida desde</label>

                    <div class="input-group">
                        <span class="input-group-text bg-light">
                            <i class="bi bi-calendar-event"></i>
                        </span>

                        <input type="date"
                               class="form-control"
                               @bind="fechaDesde" />
                    </div>
                </div>

                <div class="col-12 col-md-5">
                    <label class="form-label fw-semibold">Fecha de salida hasta</label>

                    <div class="input-group">
                        <span class="input-group-text bg-light">
                            <i class="bi bi-calendar-check"></i>
                        </span>

                        <input type="date"
                               class="form-control"
                               @bind="fechaHasta" />
                    </div>
                </div>

                <div class="col-12 col-md-2 d-flex align-items-end">
                    <div class="d-flex gap-2 w-100">
                        <button type="button"
                                class="btn btn-outline-primary flex-grow-1"
                                title="Aplicar filtros"
                                @onclick="Buscar">
                            <i class="bi bi-filter"></i>
                        </button>

                        <button type="button"
                                class="btn btn-outline-secondary flex-grow-1"
                                title="Limpiar filtros"
                                @onclick="Limpiar">
                            <i class="bi bi-eraser"></i>
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 p-4">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                <div>
                    <h5 class="fw-bold mb-1">Listado de vuelos</h5>
                    <p class="text-muted small mb-0">
                        Consulta la informacion de los vuelos registrados.
                    </p>
                </div>

                <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2">
                    @(vuelos?.Count ?? 0) registros
                </span>
            </div>
        </div>

        <div class="card-body p-0">

            @if (vuelos is null)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="text-muted mt-3 mb-0">Cargando vuelos...</p>
                </div>
            }
            else if (vuelos.Count == 0)
            {
                <div class="text-center py-5 px-3">
                    <i class="bi bi-airplane text-muted display-4"></i>
                    <h5 class="fw-bold mt-3">No hay vuelos disponibles</h5>
                    <p class="text-muted mb-3">
                        No se encontraron vuelos con los criterios seleccionados.
                    </p>
                    <button class="btn btn-outline-primary" @onclick="Limpiar">
                        <i class="bi bi-arrow-counterclockwise me-2"></i>Limpiar filtros
                    </button>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <QuickGrid Items="@vuelos.AsQueryable()"
                               Pagination="@paginacion"
                               Class="table table-hover align-middle mb-0">

                        <PropertyColumn Property="@(v => v.VueloId)"
                                        Title="ID"
                                        Sortable="true" />

                        <PropertyColumn Property="@(v => v.NumeroVuelo)"
                                        Title="Numero"
                                        Sortable="true" />

                        <TemplateColumn Title="Aerolinea">
                            <span class="fw-semibold">
                                @context.Aerolinea?.Nombre
                            </span>
                        </TemplateColumn>

                        <TemplateColumn Title="Destino">
                            <div>
                                <span class="fw-semibold">
                                    @context.Destino?.Ciudad
                                </span>
                                <div class="text-muted small">
                                    @context.Destino?.Pais
                                </div>
                            </div>
                        </TemplateColumn>

                        <TemplateColumn Title="Salida">
                            <span class="text-nowrap">
                                <i class="bi bi-calendar-event text-primary me-1"></i>
                                @context.FechaSalida.ToString("dd/MM/yyyy")
                            </span>
                        </TemplateColumn>

                        <TemplateColumn Title="Llegada">
                            <span class="text-nowrap">
                                <i class="bi bi-calendar-check text-success me-1"></i>
                                @context.FechaLlegada.ToString("dd/MM/yyyy")
                            </span>
                        </TemplateColumn>

                        <PropertyColumn Property="@(v => v.AsientosDisponibles)"
                                        Title="Asientos"
                                        Sortable="true" />

                        <TemplateColumn Title="Precio">
                            <span class="fw-semibold text-success text-nowrap">
                                @context.Precio.ToString("C")
                            </span>
                        </TemplateColumn>

                        <TemplateColumn Title="Opciones">
                            <a href="@($"/Vuelos/Edit/{context.VueloId}")"
                               class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil-square me-1"></i>Editar
                            </a>
                        </TemplateColumn>

                    </QuickGrid>
                </div>

                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3 p-3 border-top">

                    <span class="text-muted small">
                        Cantidad de vuelos: @vuelos.Count
                    </span>

                    <Paginator State="@paginacion" />

                </div>
            }

        </div>
    </div>

</div>

@code {
    private List<Vuelo>? vuelos;
    private string criterioSeleccionado = "";
    private string textoBusqueda = "";
    private DateTime? fechaDesde;
    private DateTime? fechaHasta;
    private PaginationState paginacion = new PaginationState { ItemsPerPage = 5 };

    private async Task<List<Vuelo>> ObtenerLista(System.Linq.Expressions.Expression<Func<Vuelo, bool>> criterio)
    {
        var resultado = await VueloService.GetList(criterio);
        return resultado.IsSuccess ? resultado.Value! : new List<Vuelo>();
    }

    protected override async Task OnInitializedAsync()
    {
        vuelos = await ObtenerLista(v => true);
    }

    private async Task ManejarTecla(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Buscar();
        }
    }

    private async Task Buscar()
    {
        var lista = await ObtenerLista(v => true);

        if (!string.IsNullOrWhiteSpace(textoBusqueda) && !string.IsNullOrEmpty(criterioSeleccionado))
        {
            switch (criterioSeleccionado)
            {
                case "vueloId":
                    if (int.TryParse(textoBusqueda, out int idBuscado))
                        lista = lista.Where(v => v.VueloId == idBuscado).ToList();
                    else
                        lista = new List<Vuelo>();
                    break;

                case "numeroVuelo":
                    lista = lista.Where(v => v.NumeroVuelo.ToLower().Contains(textoBusqueda.ToLower())).ToList();
                    break;

                case "aerolinea":
                    lista = lista.Where(v => v.Aerolinea != null && v.Aerolinea.Nombre.ToLower().Contains(textoBusqueda.ToLower())).ToList();
                    break;

                case "destino":
                    lista = lista.Where(v => v.Destino != null && v.Destino.Ciudad.ToLower().Contains(textoBusqueda.ToLower())).ToList();
                    break;
            }
        }

        if (fechaDesde.HasValue)
        {
            lista = lista.Where(v => v.FechaSalida.Date >= fechaDesde.Value.Date).ToList();
        }

        if (fechaHasta.HasValue)
        {
            lista = lista.Where(v => v.FechaSalida.Date <= fechaHasta.Value.Date).ToList();
        }

        vuelos = lista;
    }

    private async Task Limpiar()
    {
        criterioSeleccionado = "";
        textoBusqueda = "";
        fechaDesde = null;
        fechaHasta = null;

        vuelos = await ObtenerLista(v => true);
    }
}
