@page "/Clientes/Create"
@using ViajaYa.Models
@using ViajaYa.Services
@using ViajaYa.Extensors
@inject ClienteService ClienteService
@inject ToastService toastService
@inject NavigationManager NavigationManager

<PageTitle>Nuevo Cliente - ViajaYa</PageTitle>

<div class="create-cliente-page">

    <div class="create-navigation">
        <a href="/Clientes/Index" class="create-back-link">
            <i class="bi bi-arrow-left"></i>
            Volver a clientes
        </a>
    </div>

    <div class="create-cliente-card">

        <div class="create-cliente-header">
            <div class="header-icon">
                <i class="bi bi-person-plus-fill"></i>
            </div>

            <div>
                <span class="header-tag">GESTION DE CLIENTES</span>
                <h1>Registrar nuevo cliente</h1>
                <p>Completa los datos para agregar un cliente al sistema.</p>
            </div>
        </div>

        <EditForm Model="cliente" OnValidSubmit="@Guardar">
            <DataAnnotationsValidator />

            <div class="create-cliente-body">

                <div class="form-section-heading">
                    <div class="section-icon">
                        <i class="bi bi-person-vcard"></i>
                    </div>

                    <div>
                        <h2>Informacion personal</h2>
                        <p>Ingresa los datos personales y de contacto.</p>
                    </div>
                </div>

                <div class="form-grid">

                    <div class="form-field">
                        <label>Cedula</label>

                        <div class="custom-input-group">
                            <span>
                                <i class="bi bi-card-text"></i>
                            </span>

                            <InputText class="form-control"
                                       placeholder="Ingrese la cedula"
                                       @bind-Value="cliente.Cedula" />
                        </div>

                        <ValidationMessage For="@(() => cliente.Cedula)" />
                    </div>

                    <div class="form-field">
                        <label>Nombre completo</label>

                        <div class="custom-input-group">
                            <span>
                                <i class="bi bi-person"></i>
                            </span>

                            <InputText class="form-control"
                                       placeholder="Ingrese el nombre"
                                       @bind-Value="cliente.Nombre" />
                        </div>

                        <ValidationMessage For="@(() => cliente.Nombre)" />
                    </div>

                    <div class="form-field">
                        <label>Telefono</label>

                        <div class="custom-input-group">
                            <span>
                                <i class="bi bi-telephone"></i>
                            </span>

                            <InputText class="form-control"
                                       placeholder="Ingrese el telefono"
                                       @bind-Value="cliente.Telefono" />
                        </div>

                        <ValidationMessage For="@(() => cliente.Telefono)" />
                    </div>

                    <div class="form-field">
                        <label>Correo electronico</label>

                        <div class="custom-input-group">
                            <span>
                                <i class="bi bi-envelope"></i>
                            </span>

                            <InputText class="form-control"
                                       placeholder="Ingrese el correo"
                                       @bind-Value="cliente.Email" />
                        </div>

                        <ValidationMessage For="@(() => cliente.Email)" />
                    </div>

                </div>

            </div>

            <div class="create-cliente-footer">

                <a href="/Clientes/Index" class="btn-cancel-client">
                    <i class="bi bi-x-circle"></i>
                    Cancelar
                </a>

                <button type="submit" class="btn-save-client">
                    <i class="bi bi-floppy"></i>
                    Guardar cliente
                </button>

            </div>

        </EditForm>

    </div>
</div>

@code {
    private Cliente cliente { get; set; } = new Cliente();

    private async Task Guardar()
    {
        var resultado = await ClienteService.Guardar(cliente);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("El cliente ha sido creado exitosamente.");
            NavigationManager.NavigateTo("/Clientes/Index");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError(resultado.Error.Description);
        });
    }
}
