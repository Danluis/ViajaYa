@page "/Clientes/Index"
@using ViajaYa.Models
@using ViajaYa.Services
@using Microsoft.AspNetCore.Components.QuickGrid
@inject ClienteService ClienteService
@rendermode InteractiveServer

<PageTitle>Clientes - ViajaYa</PageTitle>

<div class="clientes-page">

    <div class="clientes-header">
        <div>
            <a href="/" class="back-link">
                <i class="bi bi-arrow-left"></i> Volver al inicio
            </a>

            <span class="section-tag">GESTION DEL SISTEMA</span>
            <h1>Clientes</h1>
            <p>Consulta, busca y administra los clientes registrados.</p>
        </div>

        <a href="/Clientes/Create" class="btn-new-client">
            <i class="bi bi-plus-lg"></i>
            Nuevo cliente
        </a>
    </div>

    <div class="clientes-stats">
        <div class="stat-icon">
            <i class="bi bi-people-fill"></i>
        </div>
        <div>
            <span>Total de clientes</span>
            <strong>@(clientes?.Count ?? 0)</strong>
        </div>
    </div>

    <div class="clientes-card">

        <div class="card-heading">
            <div>
                <h2>Listado de clientes</h2>
                <p>Consulta la informacion de tus clientes.</p>
            </div>

            <span class="records-badge">
                <i class="bi bi-person-lines-fill"></i>
                @(clientes?.Count ?? 0) registros
            </span>
        </div>

        <div class="search-panel">
            <div class="filter-field">
                <label>Filtrar por</label>
                <select class="form-select" @bind="criterioSeleccionado">
                    <option value="">Elija una opcion</option>
                    <option value="clienteId">ID</option>
                    <option value="cedula">Cedula</option>
                    <option value="nombre">Nombre</option>
                    <option value="telefono">Telefono</option>
                    <option value="email">Email</option>
                </select>
            </div>

            <div class="search-field">
                <label>Buscar cliente</label>
                <div class="input-group">
                    <input type="text"
                           class="form-control"
                           placeholder="Escribe para buscar..."
                           @bind="textoBusqueda"
                           @bind:event="oninput"
                           @onkeyup="ManejarTecla" />

                    <button class="btn-search" @onclick="Buscar">
                        <i class="bi bi-search"></i>
                        Buscar
                    </button>
                </div>
            </div>
        </div>

        @if (clientes is null)
        {
            <div class="loading-state">
                <div class="spinner-border text-primary"></div>
                <p>Cargando clientes...</p>
            </div>
        }
        else if (clientes.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-person-exclamation"></i>
                <h3>No se encontraron clientes</h3>
                <p>Intenta cambiar los criterios de busqueda.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <QuickGrid Items="@clientes.AsQueryable()"
                           Pagination="@paginacion"
                           Class="clientes-table">

                    <PropertyColumn Property="@(c => c.ClienteId)"
                                    Title="ID"
                                    Sortable="true" />

                    <PropertyColumn Property="@(c => c.Cedula)"
                                    Title="Cedula"
                                    Sortable="true" />

                    <PropertyColumn Property="@(c => c.Nombre)"
                                    Title="Nombre"
                                    Sortable="true" />

                    <PropertyColumn Property="@(c => c.Telefono)"
                                    Title="Telefono"
                                    Sortable="true" />

                    <PropertyColumn Property="@(c => c.Email)"
                                    Title="Correo electronico"
                                    Sortable="true" />

                    <TemplateColumn Title="Opciones">
                        <a href="@($"/Clientes/Edit/{context.ClienteId}")"
                           class="btn-edit-client">
                            <i class="bi bi-pencil-square"></i>
                            Editar
                        </a>
                    </TemplateColumn>

                </QuickGrid>
            </div>

            <div class="table-footer">
                <span>Mostrando @clientes.Count clientes registrados</span>
                <Paginator State="@paginacion" />
            </div>
        }

    </div>
</div>

@code {
    private List<Cliente>? clientes;
    private string criterioSeleccionado = "";
    private string textoBusqueda = "";
    private PaginationState paginacion = new PaginationState { ItemsPerPage = 5 };

    private async Task<List<Cliente>> ObtenerLista(System.Linq.Expressions.Expression<Func<Cliente, bool>> criterio)
    {
        var resultado = await ClienteService.GetList(criterio);
        return resultado.IsSuccess ? resultado.Value! : new List<Cliente>();
    }

    protected override async Task OnInitializedAsync()
    {
        clientes = await ObtenerLista(c => true);
    }

    private async Task ManejarTecla(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Buscar();
        }
    }

    private async Task Buscar()
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda) || string.IsNullOrEmpty(criterioSeleccionado))
        {
            clientes = await ObtenerLista(c => true);
            return;
        }

        switch (criterioSeleccionado)
        {
            case "clienteId":
                if (int.TryParse(textoBusqueda, out int idBuscado))
                    clientes = await ObtenerLista(c => c.ClienteId == idBuscado);
                else
                    clientes = new List<Cliente>();
                break;

            case "cedula":
                clientes = await ObtenerLista(c => c.Cedula.ToLower().Contains(textoBusqueda.ToLower()));
                break;

            case "nombre":
                clientes = await ObtenerLista(c => c.Nombre.ToLower().Contains(textoBusqueda.ToLower()));
                break;

            case "telefono":
                clientes = await ObtenerLista(c => c.Telefono.ToLower().Contains(textoBusqueda.ToLower()));
                break;

            case "email":
                clientes = await ObtenerLista(c => c.Email.ToLower().Contains(textoBusqueda.ToLower()));
                break;

            default:
                clientes = await ObtenerLista(c => true);
                break;
        }
    }
}
