@page "/Clientes/Edit/{ClienteId:int}"
@using ViajaYa.Models
@using ViajaYa.Services
@using ViajaYa.Extensors
@inject ClienteService ClienteService
@inject ToastService toastService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Editar Cliente - ViajaYa</PageTitle>

<div class="create-cliente-page">

    <div class="create-navigation">
        <a href="/Clientes/Index" class="create-back-link">
            <i class="bi bi-arrow-left"></i>
            Volver a clientes
        </a>
    </div>

    @if (cliente.ClienteId == 0)
    {
        <div class="edit-loading">
            <div class="spinner-border text-primary"></div>
            <p>Cargando informacion del cliente...</p>
        </div>
    }
    else
    {
        <div class="create-cliente-card">

            <div class="create-cliente-header">
                <div class="header-icon">
                    <i class="bi bi-person-gear"></i>
                </div>

                <div>
                    <span class="header-tag">GESTION DE CLIENTES</span>
                    <h1>Editar cliente</h1>
                    <p>Modifica la informacion del cliente seleccionado.</p>
                </div>
            </div>

            <EditForm Model="cliente" OnValidSubmit="@Modificar">
                <DataAnnotationsValidator />

                <div class="create-cliente-body">

                    <div class="form-section-heading">
                        <div class="section-icon">
                            <i class="bi bi-person-vcard"></i>
                        </div>

                        <div>
                            <h2>Informacion personal</h2>
                            <p>Actualiza los datos personales y de contacto.</p>
                        </div>

                        <span class="client-number">
                            Cliente #@cliente.ClienteId
                        </span>
                    </div>

                    <div class="form-grid">

                        <div class="form-field">
                            <label>Cedula</label>

                            <div class="custom-input-group">
                                <span>
                                    <i class="bi bi-card-text"></i>
                                </span>

                                <InputText class="form-control"
                                           placeholder="Ingrese la cedula"
                                           @bind-Value="cliente.Cedula" />
                            </div>

                            <ValidationMessage For="@(() => cliente.Cedula)" />
                        </div>

                        <div class="form-field">
                            <label>Nombre completo</label>

                            <div class="custom-input-group">
                                <span>
                                    <i class="bi bi-person"></i>
                                </span>

                                <InputText class="form-control"
                                           placeholder="Ingrese el nombre"
                                           @bind-Value="cliente.Nombre" />
                            </div>

                            <ValidationMessage For="@(() => cliente.Nombre)" />
                        </div>

                        <div class="form-field">
                            <label>Telefono</label>

                            <div class="custom-input-group">
                                <span>
                                    <i class="bi bi-telephone"></i>
                                </span>

                                <InputText class="form-control"
                                           placeholder="Ingrese el telefono"
                                           @bind-Value="cliente.Telefono" />
                            </div>

                            <ValidationMessage For="@(() => cliente.Telefono)" />
                        </div>

                        <div class="form-field">
                            <label>Correo electronico</label>

                            <div class="custom-input-group">
                                <span>
                                    <i class="bi bi-envelope"></i>
                                </span>

                                <InputText class="form-control"
                                           placeholder="Ingrese el correo"
                                           @bind-Value="cliente.Email" />
                            </div>

                            <ValidationMessage For="@(() => cliente.Email)" />
                        </div>

                    </div>
                </div>

                <div class="edit-cliente-footer">

                    <button type="button"
                            class="btn-delete-client"
                            @onclick="Eliminar">
                        <i class="bi bi-trash"></i>
                        Eliminar cliente
                    </button>

                    <div class="edit-footer-actions">
                        <a href="/Clientes/Index" class="btn-cancel-client">
                            Cancelar
                        </a>

                        <button type="submit" class="btn-save-client">
                            <i class="bi bi-floppy"></i>
                            Guardar cambios
                        </button>
                    </div>

                </div>

            </EditForm>

        </div>
    }
</div>

@if (mostrarModal)
{
    <div class="delete-modal-overlay"
         role="dialog"
         aria-modal="true"
         aria-labelledby="delete-modal-title">

        <div class="delete-modal-card">

            <div class="delete-modal-header">
                <div class="delete-modal-icon">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>

                <h2 id="delete-modal-title">Confirmar eliminacion</h2>
            </div>

            <div class="delete-modal-body">
                <p>
                    Estas seguro de que deseas eliminar este cliente?
                </p>

                <span>
                    Esta accion no se puede deshacer.
                </span>
            </div>

            <div class="delete-modal-footer">
                <button type="button"
                        class="btn-cancel-client"
                        @onclick="CerrarModal">
                    Cancelar
                </button>

                <button type="button"
                        class="btn-delete-confirm"
                        @onclick="ConfirmarEliminar">
                    <i class="bi bi-trash"></i>
                    Eliminar
                </button>
            </div>

        </div>
    </div>
}

@code {
    [Parameter]
    public int ClienteId { get; set; }

    private Cliente cliente { get; set; } = new Cliente();
    private bool mostrarModal = false;

    protected override async Task OnInitializedAsync()
    {
        var resultado = await ClienteService.Buscar(ClienteId);

        if (resultado.IsSuccess && resultado.Value is not null)
        {
            cliente = resultado.Value;
        }
        else
        {
            toastService.ShowError("Cliente no encontrado");
            NavigationManager.NavigateTo("/Clientes/Index");
        }
    }

    private async Task Modificar()
    {
        var resultado = await ClienteService.Guardar(cliente);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("Cliente modificado correctamente");
            NavigationManager.NavigateTo("/Clientes/Index");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError(resultado.Error.Description);
        });
    }

    private void Eliminar()
    {
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private async Task ConfirmarEliminar()
    {
        mostrarModal = false;

        var resultado = await ClienteService.Eliminar(cliente.ClienteId);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("Cliente eliminado correctamente");
            NavigationManager.NavigateTo("/Clientes/Index");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError(resultado.Error.Description);
        });
    }
}
