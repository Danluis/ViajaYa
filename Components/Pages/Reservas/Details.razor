@page "/reservas/detalles/{Id:int}"

@using Microsoft.EntityFrameworkCore
@using ViajaYa.Data
@using ViajaYa.Models

@inject ApplicationDbContext Contexto
@inject IJSRuntime JS

<PageTitle>Detalles de Reserva</PageTitle>

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Detalles Reserva</h2>
            <p class="text-muted mb-0">Informacion completa de la reserva</p>
        </div>

        <button class="btn btn-outline-secondary" @onclick="Volver">
            <i class="bi bi-arrow-left"></i> Atras
        </button>
    </div>

    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-2">Cargando reserva...</p>
        </div>
    }
    else if (reserva == null)
    {
        <div class="alert alert-warning">
            No se encontro la reserva solicitada.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <span class="text-muted">Codigo de reserva</span>
                        <h3 class="fw-bold mb-0">@reserva.Codigo</h3>
                    </div>

                    <span class="badge bg-success fs-6">
                        @reserva.Estado
                    </span>
                </div>
            </div>
        </div>

        <div class="row g-4">

            <div class="col-lg-8">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body p-4">

                        <h5 class="fw-bold mb-4">Informacion del vuelo</h5>

                        <div class="row mb-4">
                            <div class="col-md-5">
                                <span class="text-muted">Origen</span>
                                <h4 class="fw-bold">
                                    @reserva.Vuelo?.Origen
                                </h4>
                            </div>

                            <div class="col-md-2 text-center d-flex align-items-center justify-content-center">
                                <i class="bi bi-airplane fs-3 text-primary"></i>
                            </div>

                            <div class="col-md-5">
                                <span class="text-muted">Destino</span>
                                <h4 class="fw-bold">
                                    @reserva.Vuelo?.Destino
                                </h4>
                            </div>
                        </div>

                        <hr />

                        <div class="row g-3 mt-2">
                            <div class="col-md-6">
                                <span class="text-muted">Fecha del vuelo</span>
                                <p class="fw-semibold">
                                    @reserva.Vuelo?.Fecha.ToString("dd/MM/yyyy")
                                </p>
                            </div>

                            <div class="col-md-6">
                                <span class="text-muted">Hora de salida</span>
                                <p class="fw-semibold">
                                    @reserva.Vuelo?.HoraSalida.ToString(@"hh\:mm")
                                </p>
                            </div>

                            <div class="col-md-6">
                                <span class="text-muted">Hora de llegada</span>
                                <p class="fw-semibold">
                                    @reserva.Vuelo?.HoraLlegada.ToString(@"hh\:mm")
                                </p>
                            </div>

                            <div class="col-md-6">
                                <span class="text-muted">Tiempo estimado</span>
                                <p class="fw-semibold">
                                    @reserva.Vuelo?.TiempoEstimado minutos
                                </p>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-4">Datos de la reserva</h5>

                        <div class="mb-3">
                            <span class="text-muted">Cantidad de pasajeros</span>
                            <p class="fw-semibold">
                                @reserva.CantidadPasajeros
                            </p>
                        </div>

                        <div class="mb-3">
                            <span class="text-muted">Cliente</span>
                            <p class="fw-semibold">
                                @reserva.Cliente?.Nombre @reserva.Cliente?.Apellido
                            </p>
                        </div>

                        <div class="mb-3">
                            <span class="text-muted">Telefono</span>
                            <p class="fw-semibold">
                                @reserva.Cliente?.Telefono
                            </p>
                        </div>

                        <div class="mb-3">
                            <span class="text-muted">Correo</span>
                            <p class="fw-semibold">
                                @reserva.Cliente?.Correo
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3">Informacion de la aeronave</h5>

                        <div class="mb-3">
                            <span class="text-muted">Nombre</span>
                            <p class="fw-semibold">@reserva.Aeronave?.Nombre</p>
                        </div>

                        <div class="mb-3">
                            <span class="text-muted">Modelo</span>
                            <p class="fw-semibold">@reserva.Aeronave?.Modelo</p>
                        </div>

                        <div class="mb-3">
                            <span class="text-muted">Tipo</span>
                            <p class="fw-semibold">@reserva.Aeronave?.Tipo</p>
                        </div>

                        <div class="mb-3">
                            <span class="text-muted">Matricula</span>
                            <p class="fw-semibold">@reserva.Aeronave?.Matricula</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3">Informacion de pagos</h5>

                        @if (reserva.Pagos.Any())
                        {
                            @foreach (var pago in reserva.Pagos)
                            {
                                <div class="border-bottom pb-2 mb-3">
                                    <p class="mb-1">
                                        <strong>Monto:</strong>
                                        @pago.Monto.ToString("N2")
                                    </p>
                                    <p class="mb-1">
                                        <strong>Fecha:</strong>
                                        @pago.Fecha.ToString("dd/MM/yyyy")
                                    </p>
                                    <p class="mb-1">
                                        <strong>Metodo:</strong>
                                        @pago.Metodo
                                    </p>
                                    <p class="mb-1">
                                        <strong>Estado:</strong>
                                        @pago.Estado
                                    </p>
                                    <p class="mb-0">
                                        <strong>Comprobante:</strong>
                                        @(pago.NumeroComprobante ?? "No registrado")
                                    </p>
                                </div>
                            }

                            <div class="d-flex justify-content-between fw-bold">
                                <span>Total registrado:</span>
                                <span>@reserva.Pagos.Sum(p => p.Monto).ToString("N2")</span>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">
                                Esta reserva no tiene pagos registrados.
                            </p>
                        }
                    </div>
                </div>
            </div>

        </div>

        <div class="d-flex justify-content-end mt-4">
            <button class="btn btn-primary" @onclick="Imprimir">
                <i class="bi bi-file-earmark-pdf"></i>
                Imprimir PDF
            </button>
        </div>
    }

</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Reserva? reserva;
    private bool cargando = true;

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;

        reserva = await Contexto.Reservas
            .AsNoTracking()
            .Include(r => r.Cliente)
            .Include(r => r.Vuelo)
            .Include(r => r.Aeronave)
            .Include(r => r.Pagos)
            .FirstOrDefaultAsync(r => r.ReservaId == Id);

        cargando = false;
    }

    private void Volver()
    {
        NavigationManager.NavigateTo("/reservas");
    }

    private async Task Imprimir()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;
}
