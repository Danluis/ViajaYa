@page "/Agentes/Index"
@using ViajaYa.Models
@using ViajaYa.Services
@using Microsoft.AspNetCore.Components.QuickGrid
@inject AgenteService AgenteService
@rendermode InteractiveServer

<PageTitle>Agentes - ViajaYa</PageTitle>

<div class="agentes-page">

    <a href="/" class="back-link">
        <i class="bi bi-arrow-left me-2"></i>
        Volver al inicio
    </a>

    <div class="agentes-header">

        <div>
            <span class="section-tag">Administracion</span>
            <h1>Gestion de Agentes</h1>
            <p>Consulta y administra los agentes registrados en ViajaYa.</p>
        </div>

        <a href="/Agentes/Create" class="btn-new-agente">
            <i class="bi bi-plus-circle"></i>
            Nuevo agente
        </a>

    </div>

    @if (agentes is not null)
    {
        <div class="agentes-stats">

            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon">
                    <i class="bi bi-people"></i>
                </div>

                <div>
                    <p class="text-muted mb-1">Total de agentes</p>
                    <h3 class="fw-bold mb-0">@agentes.Count</h3>
                </div>
            </div>

        </div>
    }

    <div class="agentes-card">

        <div class="card-heading">
            <h5>
                <i class="bi bi-funnel text-primary me-2"></i>
                Buscar agentes
            </h5>

            <p>Selecciona un criterio para filtrar los registros.</p>
        </div>

        <div class="search-panel">

            <div class="row g-3">

                <div class="col-12 col-md-4 filter-field">
                    <label>Filtrar por</label>

                    <select class="form-select" @bind="criterioSeleccionado">
                        <option value="">Elija una opcion</option>
                        <option value="agenteId">ID</option>
                        <option value="nombre">Nombre</option>
                        <option value="codigo">Codigo</option>
                    </select>
                </div>

                <div class="col-12 col-md-6 filter-field">
                    <label>Busqueda</label>

                    <div class="input-group search-field">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               class="form-control"
                               placeholder="Escribe para buscar..."
                               @bind="textoBusqueda"
                               @bind:event="oninput"
                               @onkeyup="ManejarTecla" />

                        <button class="btn-search" @onclick="Buscar">
                            Buscar
                        </button>
                    </div>
                </div>

                <div class="col-12 col-md-2 filter-field d-flex flex-column justify-content-end">
                    <label class="d-none d-md-block">&nbsp;</label>

                    <button class="btn btn-outline-secondary btn-clear"
                            @onclick="Limpiar">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>
                        Limpiar
                    </button>
                </div>

            </div>

        </div>

        @if (agentes is null)
        {
            <div class="loading-state">
                <div class="spinner-border text-primary"></div>
                <p class="mt-3">Cargando agentes...</p>
            </div>
        }
        else if (agentes.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-person-x"></i>
                <h5>No se encontraron agentes</h5>
                <p>No hay registros que coincidan con la busqueda.</p>
            </div>
        }
        else
        {
            <div class="table-container">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0">Listado de agentes</h6>

                    <span class="records-badge">
                        @agentes.Count registros
                    </span>
                </div>

                <div class="table-responsive">

                    <QuickGrid Items="@agentes.AsQueryable()"
                               Pagination="@paginacion"
                               Class="agentes-table">

                        <PropertyColumn Property="@(a => a.AgenteId)"
                                        Title="ID"
                                        Sortable="true" />

                        <PropertyColumn Property="@(a => a.Nombre)"
                                        Title="Nombre"
                                        Sortable="true" />

                        <PropertyColumn Property="@(a => a.Codigo)"
                                        Title="Codigo"
                                        Sortable="true" />

                        <TemplateColumn Title="Opciones">
                            <a href="@($"/Agentes/Edit/{context.AgenteId}")"
                               class="btn-edit-agente">
                                <i class="bi bi-pencil-square"></i>
                                Editar
                            </a>
                        </TemplateColumn>

                    </QuickGrid>

                </div>

            </div>

            <div class="table-footer">
                <span>
                    Mostrando @agentes.Count agentes registrados.
                </span>

                <Paginator State="@paginacion" />
            </div>
        }

    </div>

</div>

@code {
    private List<Agente>? agentes;
    private string criterioSeleccionado = "";
    private string textoBusqueda = "";

    private PaginationState paginacion = new PaginationState
    {
        ItemsPerPage = 5
    };

    private async Task<List<Agente>> ObtenerLista(
        System.Linq.Expressions.Expression<Func<Agente, bool>> criterio)
    {
        var resultado = await AgenteService.GetList(criterio);

        return resultado.IsSuccess
            ? resultado.Value!
            : new List<Agente>();
    }

    protected override async Task OnInitializedAsync()
    {
        agentes = await ObtenerLista(a => true);
    }

    private async Task ManejarTecla(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Buscar();
        }
    }

    private async Task Buscar()
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda) ||
            string.IsNullOrEmpty(criterioSeleccionado))
        {
            agentes = await ObtenerLista(a => true);
            return;
        }

        switch (criterioSeleccionado)
        {
            case "agenteId":
                if (int.TryParse(textoBusqueda, out int idBuscado))
                {
                    agentes = await ObtenerLista(a => a.AgenteId == idBuscado);
                }
                else
                {
                    agentes = new List<Agente>();
                }
                break;

            case "nombre":
                agentes = await ObtenerLista(a =>
                    a.Nombre.ToLower().Contains(textoBusqueda.ToLower()));
                break;

            case "codigo":
                agentes = await ObtenerLista(a =>
                    a.Codigo.ToLower().Contains(textoBusqueda.ToLower()));
                break;

            default:
                agentes = await ObtenerLista(a => true);
                break;
        }
    }

    private async Task Limpiar()
    {
        criterioSeleccionado = "";
        textoBusqueda = "";

        agentes = await ObtenerLista(a => true);
    }
}
