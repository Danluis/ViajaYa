@page "/Agentes/Edit/{AgenteId:int}"
@using ViajaYa.Models
@using ViajaYa.Services
@using ViajaYa.Extensors
@inject AgenteService AgenteService
@inject ToastService toastService
@inject NavigationManager NavigationManager

<PageTitle>Editar Agente - ViajaYa</PageTitle>

<div class="agente-edit-page">

    <a href="/Agentes/Index" class="agente-edit-back">
        <i class="bi bi-arrow-left me-2"></i>
        Volver a agentes
    </a>

    @if (agente.AgenteId == 0)
    {
        <div class="agente-loading">
            <div class="spinner-border text-primary"></div>
            <p class="mt-3">Cargando informacion del agente...</p>
        </div>
    }
    else
    {
        <div class="agente-edit-header">
            <div class="header-icon">
                <i class="bi bi-person-gear"></i>
            </div>

            <div>
                <h1>Editar agente</h1>
                <p>Modifica la informacion del agente seleccionado.</p>
            </div>
        </div>

        <div class="agente-edit-card">

            <EditForm Model="agente" OnValidSubmit="@Modificar">
                <DataAnnotationsValidator />

                <div class="agente-edit-body">

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
                        <div>
                            <h5 class="agente-section-title">
                                <i class="bi bi-person-vcard me-2"></i>
                                Informacion del agente
                            </h5>

                            <p class="agente-section-description">
                                Actualiza el nombre y el codigo del agente.
                            </p>
                        </div>

                        <span class="agente-id-badge">
                            Agente #@agente.AgenteId
                        </span>
                    </div>

                    <hr class="agente-form-divider" />

                    <div class="row g-4">

                        <div class="col-12 agente-edit-field">
                            <label>Nombre</label>

                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-person"></i>
                                </span>

                                <InputText class="form-control"
                                           placeholder="Ingrese el nombre del agente"
                                           @bind-Value="agente.Nombre" />
                            </div>

                            <ValidationMessage For="@(() => agente.Nombre)" />
                        </div>

                        <div class="col-12 agente-edit-field">
                            <label>Codigo</label>

                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-upc-scan"></i>
                                </span>

                                <InputText class="form-control"
                                           placeholder="Ingrese el codigo del agente"
                                           @bind-Value="agente.Codigo" />
                            </div>

                            <ValidationMessage For="@(() => agente.Codigo)" />
                        </div>

                    </div>

                </div>

                <div class="agente-edit-footer">

                    <button type="button"
                            class="agente-btn-delete"
                            @onclick="Eliminar">
                        <i class="bi bi-trash"></i>
                        Eliminar agente
                    </button>

                    <div class="agente-edit-actions">

                        <a href="/Agentes/Index" class="agente-btn-cancel">
                            <i class="bi bi-x-lg"></i>
                            Cancelar
                        </a>

                        <button type="submit" class="agente-btn-save">
                            <i class="bi bi-floppy"></i>
                            Guardar cambios
                        </button>

                    </div>

                </div>

            </EditForm>

        </div>
    }

</div>

@if (mostrarModal)
{
    <div class="agente-modal" role="dialog" aria-modal="true">

        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle text-danger me-2"></i>
                        Confirmar eliminacion
                    </h5>

                    <button type="button"
                            class="btn-close"
                            aria-label="Cerrar"
                            @onclick="CerrarModal">
                    </button>
                </div>

                <div class="modal-body">
                    <p class="mb-2">
                        Estas seguro de que deseas eliminar este agente?
                    </p>

                    <p class="text-muted small mb-0">
                        Esta accion no se puede deshacer.
                    </p>
                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            @onclick="CerrarModal">
                        Cancelar
                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            @onclick="ConfirmarEliminar">
                        <i class="bi bi-trash me-2"></i>
                        Eliminar
                    </button>

                </div>

            </div>
        </div>

    </div>
}

@code {
    [Parameter]
    public int AgenteId { get; set; }

    private Agente agente { get; set; } = new Agente();
    private bool mostrarModal = false;

    protected override async Task OnInitializedAsync()
    {
        var resultado = await AgenteService.Buscar(AgenteId);

        if (resultado.IsSuccess && resultado.Value is not null)
        {
            agente = resultado.Value;
        }
        else
        {
            toastService.ShowError("Agente no encontrado");
            NavigationManager.NavigateTo("/Agentes/Index");
        }
    }

    private async Task Modificar()
    {
        var resultado = await AgenteService.Guardar(agente);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("Agente modificado correctamente");
            NavigationManager.NavigateTo("/Agentes/Index");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError(resultado.Error.Description);
        });
    }

    private void Eliminar()
    {
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private async Task ConfirmarEliminar()
    {
        mostrarModal = false;

        var resultado = await AgenteService.Eliminar(agente.AgenteId);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("Agente eliminado correctamente");
            NavigationManager.NavigateTo("/Agentes/Index");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError(resultado.Error.Description);
        });
    }
}
