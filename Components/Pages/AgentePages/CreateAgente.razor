@page "/Agentes/Create"
@using ViajaYa.Models
@using ViajaYa.Services
@using ViajaYa.Extensors
@inject AgenteService AgenteService
@inject ToastService toastService
@inject NavigationManager NavigationManager

<PageTitle>Nuevo Agente - ViajaYa</PageTitle>

<div class="agente-form-page">

    <a href="/Agentes/Index" class="agente-back-link">
        <i class="bi bi-arrow-left me-2"></i>
        Volver a agentes
    </a>

    <div class="agente-form-header">
        <div class="header-icon">
            <i class="bi bi-person-plus"></i>
        </div>

        <div>
            <h1>Registrar agente</h1>
            <p>Completa los datos para registrar un nuevo agente.</p>
        </div>
    </div>

    <div class="agente-form-card">

        <EditForm Model="agente" OnValidSubmit="@Guardar">
            <DataAnnotationsValidator />

            <div class="agente-form-body">

                <h5 class="agente-section-title">
                    <i class="bi bi-person-vcard me-2"></i>
                    Informacion del agente
                </h5>

                <p class="agente-section-description">
                    Introduce el nombre y el codigo correspondiente al agente.
                </p>

                <hr class="agente-form-divider" />

                <div class="row g-4">

                    <div class="col-12 agente-field">
                        <label>Nombre</label>

                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-person"></i>
                            </span>

                            <InputText class="form-control"
                                       placeholder="Ingrese el nombre del agente"
                                       @bind-Value="agente.Nombre" />
                        </div>

                        <ValidationMessage For="@(() => agente.Nombre)" />
                    </div>

                    <div class="col-12 agente-field">
                        <label>Codigo</label>

                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-upc-scan"></i>
                            </span>

                            <InputText class="form-control"
                                       placeholder="Ingrese el codigo del agente"
                                       @bind-Value="agente.Codigo" />
                        </div>

                        <ValidationMessage For="@(() => agente.Codigo)" />
                    </div>

                </div>

            </div>

            <div class="agente-form-footer">

                <a href="/Agentes/Index" class="agente-btn-cancel">
                    <i class="bi bi-x-lg"></i>
                    Cancelar
                </a>

                <button type="submit" class="agente-btn-save">
                    <i class="bi bi-floppy"></i>
                    Guardar agente
                </button>

            </div>

        </EditForm>

    </div>

</div>

@code {
    private Agente agente { get; set; } = new Agente();

    private async Task Guardar()
    {
        var resultado = await AgenteService.Guardar(agente);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("El agente ha sido creado exitosamente.");
            NavigationManager.NavigateTo("/Agentes/Index");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError(resultado.Error.Description);
        });
    }
}
