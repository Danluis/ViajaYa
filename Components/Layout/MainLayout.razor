@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<div class="app-layout">

    <header class="app-header">
        <div class="header-container">

            <a href="/" class="brand">
                <span class="brand-icon">
                    <i class="bi bi-airplane-engines-fill"></i>
                </span>

                <span class="brand-text">
                    <strong>ViajaYa</strong>
                    <small>Gestion de viajes</small>
                </span>
            </a>

            <div class="header-actions">
                <AuthorizeView>
                    <Authorized>
                        <a href="/Account/Manage" class="user-link">
                            <i class="bi bi-person-circle"></i>
                            <span>@context.User.Identity?.Name</span>
                        </a>

                        <form action="Account/Logout" method="post">
                            <AntiforgeryToken />
                            <input type="hidden" name="ReturnUrl" value="/" />

                            <button type="submit" class="btn-logout">
                                <i class="bi bi-box-arrow-right"></i>
                                Salir
                            </button>
                        </form>
                    </Authorized>

                    <NotAuthorized>
                        <a href="/Account/Login" class="btn-login">
                            Iniciar sesion
                        </a>

                        <a href="/Account/Register" class="btn-register">
                            Registrarse
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>

        </div>
    </header>

    <main class="main-content">
        @Body
    </main>

    <footer class="app-footer">
        <p>ViajaYa &copy; 2026 - Sistema de gestion de viajes</p>
    </footer>

</div>

@if (mostrarSplash)
{
    <div class="splash-screen">

        <div class="splash-content">

            <div class="splash-logo">
                <i class="bi bi-airplane-engines-fill"></i>
            </div>

            <h1>ViajaYa</h1>

            <p>Tu proximo destino comienza aqui</p>

            <div class="splash-flight">
                <div class="flight-line"></div>
                <i class="bi bi-airplane-fill"></i>
            </div>

            <span class="splash-loading">Preparando tu experiencia...</span>

        </div>

        <div class="splash-footer">
            GESTION DE VIAJES
        </div>

    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    Ha ocurrido un error.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

<Toasts class="p-3" Placement="ToastsPlacement.TopRight" />

@code {
    private bool mostrarSplash = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(2500);

            await InvokeAsync(() =>
            {
                mostrarSplash = false;
                StateHasChanged();
            });
        }
    }
}
